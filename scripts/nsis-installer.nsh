!include "FileFunc.nsh"

Var genworkCurrentProcessPid
Var genworkInstallerAttemptId
Var genworkTargetProcessesStopStatus
Var genworkResolveToolKind
Var genworkResolvedToolPath
Var genworkResolvedToolStatus
Var genworkResolvedToolSource
Var genworkTrustedPowerShellPath
Var genworkTrustedPowerShellStatus
Var genworkTrustedPowerShellSource

!ifndef BUILD_UNINSTALLER
  ; Cross-hook state used by the update fast path and the electron-builder
  ; template timing hooks. These are installer variables (not registers) so
  ; nested NSIS macros cannot accidentally overwrite an in-flight timer.
  Var genworkInstallScenario
  Var genworkInvocationSource
  Var genworkUpdatedFlag
  Var genworkUiMode
  Var genworkLauncherFallback
  Var genworkLegacySkillsStatus
  Var genworkLegacySkillsRestoreStatus
  Var genworkOldAppRelaunchStatus
  Var genworkOldAppRelaunchError
  Var genworkOldAppExecutablePath
  Var genworkOldUninstallerPath
  Var genworkOldAppAsarPath
  Var genworkTrustedTarPath
  Var genworkTrustedTarStatus
  Var genworkTrustedTarSource
  Var genworkOldInstallOriginalPath
  Var genworkOldInstallOriginalPathNormalized
  Var genworkOldInstallRegisteredPath
  Var genworkOldInstallRegisteredPathNormalized
  Var genworkOldInstallAlternateRegisteredPath
  Var genworkOldInstallAlternateRegisteredPathNormalized
  Var genworkOldInstallBackupPath
  Var genworkOldInstallFailedPath
  Var genworkOldInstallRenameStatus
  Var genworkOldInstallRenameReason
  Var genworkOldInstallRenameError
  Var genworkOldInstallRenameAttempts
  Var genworkOldInstallRollbackReason
  Var genworkOldInstallRollbackStatus
  Var genworkOldInstallRollbackError
  Var genworkOldInstallCurrentDirectory
  Var genworkOldUninstallCandidatePath
  Var genworkOldUninstallCandidatePathNormalized
  Var genworkOldUninstallStartTick
  Var genworkOldUninstallLaunchStatus
  Var genworkNewInstallValidationStatus
  Var genworkNewInstallValidationReason
  !ifndef APP_PACKAGE_URL
    Var genworkPackageMaterializeStartTick
  !endif
  Var genworkPackageExtractStartTick
  Var genworkPackageCopyStartTick
  Var genworkInstallerCacheCopyStartTick
  !ifndef ESTIMATED_SIZE
    Var genworkEstimatedSizeScanStartTick
    Var genworkEstimatedSizeValue
  !endif
!endif

; -- Legacy Skills backup helper exit-code protocol --
; The PowerShell backup helper reports its outcome ONLY through these process
; exit codes. stdout is diagnostic text for the logs and must never drive
; control flow: nsExec::ExecToStack returns output with the helper's trailing
; CRLF attached, so an exact stdout comparison silently fails (this once
; misclassified "no user skills" as "backup succeeded" and produced a spurious
; legacy-restore-backup-missing degraded install).
!define GENWORK_SKILL_BACKUP_EXIT_VERIFIED "0"
!define GENWORK_SKILL_BACKUP_EXIT_INSPECT_FAILED "10"
!define GENWORK_SKILL_BACKUP_EXIT_COPY_FAILED "11"
!define GENWORK_SKILL_BACKUP_EXIT_VERIFY_FAILED "12"
!define GENWORK_SKILL_BACKUP_EXIT_NO_USER_SKILLS "13"

; -- Design invariant --
; Nothing destructive may run before the user confirms the wizard (or the
; uninstall prompt). electron-builder inserts customInit in .onInit, which
; runs when the installer is merely opened -- cancelling at the welcome or
; directory page must leave the existing installation and running app
; untouched. All destructive work (stopping processes, backing up skills,
; renaming the old install dir) therefore lives in customCheckAppRunning,
; which electron-builder inserts inside the install section -- right after
; the user clicks Install and, critically, *before* uninstallOldVersion.

; Timestamp from NSIS built-ins (FileFunc ${GetTime}). The previous
; implementation spawned a PowerShell process per call just to format a
; timestamp -- with 20+ call sites that added tens of seconds per install on
; machines where security software inspects every process launch. Second
; precision is enough: phase durations are carried separately as elapsed_ms.
;
; Preserves every register (unlike the old version, which clobbered $0; the
; "copy exit codes to $R2 first" convention at call sites is kept anyway).
; OUTVAR must not be $0-$6.
!macro GetTimestamp OUTVAR
  Push $0
  Push $1
  Push $2
  Push $3
  Push $4
  Push $5
  Push $6
  !ifdef BUILD_UNINSTALLER
    ${un.GetTime} "" "L" $0 $1 $2 $3 $4 $5 $6
  !else
    ${GetTime} "" "L" $0 $1 $2 $3 $4 $5 $6
  !endif
  ; $0=day $1=month $2=year $3=day-of-week name $4=hour $5=minute $6=second
  IntFmt $0 "%02d" $0
  IntFmt $1 "%02d" $1
  IntFmt $4 "%02d" $4
  IntFmt $5 "%02d" $5
  IntFmt $6 "%02d" $6
  StrCpy $0 "$2-$1-$0 $4:$5:$6"
  Pop $6
  Pop $5
  Pop $4
  Pop $3
  Pop $2
  Pop $1
  Exch $0
  Pop ${OUTVAR}
!macroend

; attemptId is a correlation identifier only. It is intentionally generated by
; Windows and is never used as a security nonce or authorization token.
!ifdef BUILD_UNINSTALLER
Function un.genworkEnsureInstallerAttemptId
!else
Function genworkEnsureInstallerAttemptId
!endif
  StrCmp $genworkInstallerAttemptId "" 0 GenworkAttemptIdReady
  System::Call 'ole32::CoCreateGuid(g .s)'
  Pop $genworkInstallerAttemptId
  GenworkAttemptIdReady:
FunctionEnd

!macro EnsureInstallerAttemptId
  !ifdef BUILD_UNINSTALLER
    Call un.genworkEnsureInstallerAttemptId
  !else
    Call genworkEnsureInstallerAttemptId
  !endif
!macroend

; Resolve only Windows-owned system tools, never PATH entries. Both
; PowerShell and tar use this single resolver entry so the existence check and
; the eventual execution refer to the exact same absolute path.
!ifdef BUILD_UNINSTALLER
Function un.genworkResolveTrustedSystemTool
!else
Function genworkResolveTrustedSystemTool
!endif
  Push $0
  Push $1

  StrCpy $genworkResolvedToolPath ""
  StrCpy $genworkResolvedToolStatus "helper-not-found"
  StrCpy $genworkResolvedToolSource "none"

  StrCmp $genworkResolveToolKind "powershell" GenworkResolvePowerShell
  StrCmp $genworkResolveToolKind "tar" GenworkResolveTar
  StrCpy $genworkResolvedToolStatus "unsupported-tool"
  Goto GenworkResolveToolDone

  GenworkResolvePowerShell:
    System::Call 'kernel32::GetFileAttributesW(w "$WINDIR\Sysnative\WindowsPowerShell\v1.0\powershell.exe") i .r0'
    IntCmp $0 -1 GenworkResolvePowerShellSystem32 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 GenworkResolvePowerShellSysnativeReady GenworkResolvePowerShellSystem32 GenworkResolvePowerShellSystem32
    GenworkResolvePowerShellSysnativeReady:
      StrCpy $genworkResolvedToolPath "$WINDIR\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
      StrCpy $genworkResolvedToolStatus "resolved"
      StrCpy $genworkResolvedToolSource "sysnative"
      Goto GenworkResolveToolDone

    GenworkResolvePowerShellSystem32:
    System::Call 'kernel32::GetFileAttributesW(w "$WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe") i .r0'
    IntCmp $0 -1 GenworkResolveToolDone 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 GenworkResolvePowerShellSystem32Ready GenworkResolveToolDone GenworkResolveToolDone
    GenworkResolvePowerShellSystem32Ready:
      StrCpy $genworkResolvedToolPath "$WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe"
      StrCpy $genworkResolvedToolStatus "resolved"
      StrCpy $genworkResolvedToolSource "system32"
      Goto GenworkResolveToolDone

  GenworkResolveTar:
    System::Call 'kernel32::GetFileAttributesW(w "$WINDIR\Sysnative\tar.exe") i .r0'
    IntCmp $0 -1 GenworkResolveTarSystem32 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 GenworkResolveTarSysnativeReady GenworkResolveTarSystem32 GenworkResolveTarSystem32
    GenworkResolveTarSysnativeReady:
      StrCpy $genworkResolvedToolPath "$WINDIR\Sysnative\tar.exe"
      StrCpy $genworkResolvedToolStatus "resolved"
      StrCpy $genworkResolvedToolSource "sysnative"
      Goto GenworkResolveToolDone

    GenworkResolveTarSystem32:
    System::Call 'kernel32::GetFileAttributesW(w "$WINDIR\System32\tar.exe") i .r0'
    IntCmp $0 -1 GenworkResolveToolDone 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 GenworkResolveTarSystem32Ready GenworkResolveToolDone GenworkResolveToolDone
    GenworkResolveTarSystem32Ready:
      StrCpy $genworkResolvedToolPath "$WINDIR\System32\tar.exe"
      StrCpy $genworkResolvedToolStatus "resolved"
      StrCpy $genworkResolvedToolSource "system32"

  GenworkResolveToolDone:
  Pop $1
  Pop $0
FunctionEnd

!macro ResolveTrustedPowerShell
  StrCpy $genworkResolveToolKind "powershell"
  !ifdef BUILD_UNINSTALLER
    Call un.genworkResolveTrustedSystemTool
  !else
    Call genworkResolveTrustedSystemTool
  !endif
  StrCpy $genworkTrustedPowerShellPath $genworkResolvedToolPath
  StrCpy $genworkTrustedPowerShellStatus $genworkResolvedToolStatus
  StrCpy $genworkTrustedPowerShellSource $genworkResolvedToolSource
!macroend

!macro ResolveTrustedTar
  StrCpy $genworkResolveToolKind "tar"
  !ifdef BUILD_UNINSTALLER
    Call un.genworkResolveTrustedSystemTool
  !else
    Call genworkResolveTrustedSystemTool
  !endif
  StrCpy $genworkTrustedTarPath $genworkResolvedToolPath
  StrCpy $genworkTrustedTarStatus $genworkResolvedToolStatus
  StrCpy $genworkTrustedTarSource $genworkResolvedToolSource
!macroend

!macro customHeader
  !ifndef BUILD_UNINSTALLER
    ; The custom include can be parsed before electron-builder's asynchronous
    ; !addplugindir output. Define the relaunch function here, after the
    ; generated shared header has registered StdUtils.
    !insertmacro DefineGenworkOldAppRelaunchFunction
  !endif

  ; Request admin privileges for script execution (tar extract, etc.)
  ; This does NOT change the default install path -- just ensures UAC elevation.
  RequestExecutionLevel admin

  ; Keep only the progress bar visible. The details box stays hidden and
  ; NSIS/electron-builder retains the default status text behavior.
  ShowInstDetails nevershow
!macroend

; -- Stop every process that might hold file handles in the install dir --
;
; 1. GenWork.exe -- the main app AND the OpenClaw gateway (ELECTRON_RUN_AS_NODE)
; 2. node.exe whose binary lives inside the GenWork install tree
;    (Web Search bridge server, MCP servers spawned with detached:true)
;
; Stop-Process -Force is equivalent to taskkill /F -- the processes have no
; chance to run before-quit cleanup. The kill is re-issued on every poll
; round instead of once up front: a single kill loses against a long-running
; instance whose kernel teardown outlives a fixed observation window (field
; report 2026-07-29: a loaded old app survived the previous
; kill-once-then-poll 7.5s gate, while a freshly started instance died in one
; round) and against anything respawned between the kill and a later poll.
; 30 rounds x 500ms keeps the worst-case gate under ~20s wall time; the
; healthy path still converges on the first or second round.
;
; Shared between the installer and the uninstaller via customCheckAppRunning.
!macro stopGenWorkProcesses
  DetailPrint "[Installer] Stopping running GenWork processes"
  StrCpy $genworkTargetProcessesStopStatus "helper-not-found"
  System::Call 'kernel32::GetCurrentProcessId()i .r4'
  StrCpy $genworkCurrentProcessPid $4
  System::Call 'kernel32::GetTickCount()i .r7'
  ; The survivor helper below and every log write in this macro need the
  ; directory, including on the helper-not-found path.
  CreateDirectory "$APPDATA\GenWork"
  StrCmp $genworkTrustedPowerShellPath "" StopGenWorkProcessesDone
  nsExec::ExecToLog '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
    for ($$i = 0; $$i -lt 30; $$i++) {\
      $$procs = @();\
      $$procs += Get-Process -Name GenWork -ErrorAction SilentlyContinue;\
      $$procs += Get-Process node -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like \"*GenWork*\" };\
      if ($$procs.Count -eq 0) { exit 0 };\
      $$procs | Stop-Process -Force -ErrorAction SilentlyContinue;\
      Start-Sleep -Milliseconds 500;\
    };\
    exit 3"'
  Pop $0
  StrCpy $R2 $0
  StrCpy $genworkTargetProcessesStopStatus "numeric-exit-code"
  StrCmp $R2 "error" 0 +2
    StrCpy $genworkTargetProcessesStopStatus "process-start-blocked"
  StrCmp $R2 "0" 0 +2
    StrCpy $genworkTargetProcessesStopStatus "success"
  StrCmp $R2 "3" 0 StopGenWorkProcessesLog
  ; The exit-3 verdict alone never says WHICH process refused to die. Re-snapshot
  ; and append one process-stop-survivor line per remaining process before the
  ; completion line below. Inputs travel through the child environment, not
  ; string interpolation: the log path contains the user profile directory,
  ; which may hold shell metacharacters. Helper exit code = survivor count at
  ; re-check time; 0 means the blockers died right after the verdict.
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_STOP_LOG_PATH", t "$APPDATA\GenWork\install-timing.log")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_STOP_ATTEMPT_ID", t "$genworkInstallerAttemptId")i'
  nsExec::ExecToLog '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
    $$ts = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\";\
    $$procs = @();\
    $$procs += Get-Process -Name GenWork -ErrorAction SilentlyContinue;\
    $$procs += Get-Process node -ErrorAction SilentlyContinue | Where-Object { $$_.Path -like \"*GenWork*\" };\
    foreach ($$p in $$procs) {\
      $$fp = \"unknown\";\
      try { if ($$p.Path) { $$fp = $$p.Path } } catch { };\
      Add-Content -LiteralPath $$env:GENWORK_STOP_LOG_PATH -Value \"$$ts phase=process-stop-survivor attempt_id=$$env:GENWORK_STOP_ATTEMPT_ID name=$$($$p.ProcessName) pid=$$($$p.Id) path=$$fp\" -ErrorAction SilentlyContinue;\
    };\
    exit $$procs.Count"'
  Pop $1
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_STOP_LOG_PATH", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_STOP_ATTEMPT_ID", t "")i'
  FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $9 0 END
  !insertmacro GetTimestamp $8
  !ifdef BUILD_UNINSTALLER
    FileWrite $9 "$8 phase=process-stop-survivors-logged attempt_id=$genworkInstallerAttemptId role=uninstaller helper_exit=$1$\r$\n"
  !else
    FileWrite $9 "$8 phase=process-stop-survivors-logged attempt_id=$genworkInstallerAttemptId role=installer helper_exit=$1$\r$\n"
  !endif
  FileClose $9
  Goto StopGenWorkProcessesLog

  StopGenWorkProcessesDone:
  StrCpy $R2 "helper-not-found"

  StopGenWorkProcessesLog:
  System::Call 'kernel32::GetTickCount()i .r6'
  IntOp $5 $6 - $7
  FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $9 0 END
  !insertmacro GetTimestamp $8
  !ifdef BUILD_UNINSTALLER
    FileWrite $9 "$8 phase=process-stop-complete attempt_id=$genworkInstallerAttemptId role=uninstaller pid=$genworkCurrentProcessPid status=$genworkTargetProcessesStopStatus exit=$R2 elapsed_ms=$5$\r$\n"
  !else
    FileWrite $9 "$8 phase=process-stop-complete attempt_id=$genworkInstallerAttemptId role=installer pid=$genworkCurrentProcessPid status=$genworkTargetProcessesStopStatus exit=$R2 elapsed_ms=$5$\r$\n"
  !endif
  FileClose $9
!macroend

!macro customInit
  ; Diagnostics only -- .onInit runs before the user has confirmed anything,
  ; so this macro must stay non-destructive.
  !insertmacro EnsureInstallerAttemptId
  StrCpy $genworkInvocationSource "unknown"
  StrCpy $genworkUpdatedFlag "absent"
  StrCpy $genworkUiMode "interactive"
  StrCpy $genworkLauncherFallback "unknown"
  ${If} ${isUpdated}
    StrCpy $genworkUpdatedFlag "present"
  ${EndIf}
  ${If} ${isUpdated}
  ${AndIf} ${isForceRun}
    StrCpy $genworkInvocationSource "app-update"
    StrCpy $genworkLauncherFallback "none"
  ${EndIf}
  ${If} ${Silent}
    StrCpy $genworkUiMode "silent"
  ${EndIf}
  CreateDirectory "$APPDATA\GenWork"
  FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $9 0 END
  !insertmacro GetTimestamp $8
  FileWrite $9 "$8 phase=custom-init-start attempt_id=$genworkInstallerAttemptId installer_version=${VERSION} invocation_source=$genworkInvocationSource updated_flag=$genworkUpdatedFlag ui_mode=$genworkUiMode launcher_fallback=$genworkLauncherFallback instdir=$INSTDIR appdata=$APPDATA$\r$\n"
  FileClose $9
!macroend

!ifndef BUILD_UNINSTALLER
  ; P0 preflight deliberately has only two outcomes. Any registration or
  ; non-empty target evidence remains on the existing compatibility path; the
  ; richer repair/relocate/reconcile action planner belongs to P0.5.
  !macro DetectFreshOrPossibleExisting
    Push $0
    Push $1
    Push $2
    Push $3
    Push $4
    Push $5
    Push $6

    StrCpy $genworkInstallScenario "possible-existing"
    ReadRegStr $0 HKEY_CURRENT_USER "${INSTALL_REGISTRY_KEY}" InstallLocation
    ReadRegStr $1 HKEY_LOCAL_MACHINE "${INSTALL_REGISTRY_KEY}" InstallLocation
    ReadRegStr $2 HKEY_CURRENT_USER "${UNINSTALL_REGISTRY_KEY}" UninstallString
    ReadRegStr $3 HKEY_LOCAL_MACHINE "${UNINSTALL_REGISTRY_KEY}" UninstallString

    StrCmp $0 "" 0 GenworkInstallPreflightDone
    StrCmp $1 "" 0 GenworkInstallPreflightDone
    StrCmp $2 "" 0 GenworkInstallPreflightDone
    StrCmp $3 "" 0 GenworkInstallPreflightDone

    ; .onInit already called SetOutPath, which creates an empty $INSTDIR.
    ; Enumerate its contents instead of using IfFileExists with a wildcard:
    ; wildcard directory-existence checks misclassify that empty directory as
    ; an old install. Only a real child entry is existing evidence.
    ClearErrors
    FindFirst $4 $5 "$INSTDIR\*"
    IfErrors GenworkInstallPreflightFindFirstFailed
    GenworkInstallPreflightEntryLoop:
      StrCmp $5 "." GenworkInstallPreflightNextEntry
      StrCmp $5 ".." GenworkInstallPreflightNextEntry
      FindClose $4
      Goto GenworkInstallPreflightDone
    GenworkInstallPreflightNextEntry:
      ClearErrors
      FindNext $4 $5
      IfErrors GenworkInstallPreflightFindNextFailed
      Goto GenworkInstallPreflightEntryLoop

    GenworkInstallPreflightFindNextFailed:
      System::Call 'kernel32::GetLastError()i .r6'
      FindClose $4
      IntCmp $6 18 GenworkInstallPreflightFresh
      Goto GenworkInstallPreflightDone

    GenworkInstallPreflightFindFirstFailed:
      System::Call 'kernel32::GetLastError()i .r6'
      IntCmp $6 2 GenworkInstallPreflightFresh
      IntCmp $6 18 GenworkInstallPreflightFresh
      Goto GenworkInstallPreflightDone

    GenworkInstallPreflightFresh:
    StrCpy $genworkInstallScenario "fresh-install"

    GenworkInstallPreflightDone:
    Pop $6
    Pop $5
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
  !macroend

  ; Relaunch is deliberately conservative. Only the normal interactive
  ; app-update invocation (--updated + --force-run), after a confirmed process
  ; stop and with an unchanged/restored regular old executable, is eligible.
  ; The restored app is launched with no --updated argument.
  !macro DefineGenworkOldAppRelaunchFunction
  Function genworkTryRelaunchOldApp
    Push $0
    Push $1
    Push $8
    Push $9

    StrCmp $genworkOldAppRelaunchStatus "not-attempted" 0 GenworkOldAppRelaunchDone
    StrCpy $genworkOldAppRelaunchStatus "blocked"
    StrCpy $genworkOldAppRelaunchError "intent-not-trusted"

    ; Read the generated command-line flags at relaunch time. This function is
    ; emitted by customHeader only after StdUtils has been registered.
    ${StdUtils.TestParameter} $0 "updated"
    StrCmp $0 "true" 0 GenworkOldAppRelaunchLog
    ${StdUtils.TestParameter} $0 "force-run"
    StrCmp $0 "true" 0 GenworkOldAppRelaunchLog
    IfSilent 0 GenworkOldAppRelaunchInteractive
      StrCpy $genworkOldAppRelaunchError "silent-invocation"
      Goto GenworkOldAppRelaunchLog
    GenworkOldAppRelaunchInteractive:
    StrCmp $genworkTargetProcessesStopStatus "success" 0 GenworkOldAppRelaunchProcessStateBlocked
    StrCmp $genworkOldAppExecutablePath "" 0 +3
      StrCpy $genworkOldAppRelaunchError "old-source-missing"
      Goto GenworkOldAppRelaunchLog

    System::Call 'kernel32::GetFileAttributesW(w "$genworkOldAppExecutablePath") i .r0'
    IntCmp $0 -1 GenworkOldAppRelaunchFootprintBlocked 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 0 GenworkOldAppRelaunchFootprintBlocked GenworkOldAppRelaunchFootprintBlocked
    System::Call 'kernel32::GetFileAttributesW(w "$genworkOldUninstallerPath") i .r0'
    IntCmp $0 -1 GenworkOldAppRelaunchFootprintBlocked 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 0 GenworkOldAppRelaunchFootprintBlocked GenworkOldAppRelaunchFootprintBlocked
    System::Call 'kernel32::GetFileAttributesW(w "$genworkOldAppAsarPath") i .r0'
    IntCmp $0 -1 GenworkOldAppRelaunchFootprintBlocked 0 0
    IntOp $1 $0 & 0x410
    IntCmp $1 0 0 GenworkOldAppRelaunchFootprintBlocked GenworkOldAppRelaunchFootprintBlocked

    StrCpy $genworkOldAppRelaunchStatus "attempted"
    StrCpy $genworkOldAppRelaunchError "none"
    ${StdUtils.ExecShellAsUser} $0 "$genworkOldAppExecutablePath" "open" ""
    StrCpy $genworkOldAppRelaunchError $0
    StrCmp $0 "0" GenworkOldAppRelaunchSucceeded
      StrCpy $genworkOldAppRelaunchStatus "old-app-relaunch-failed"
      Goto GenworkOldAppRelaunchLog
    GenworkOldAppRelaunchSucceeded:
      StrCpy $genworkOldAppRelaunchStatus "dispatched"
    Goto GenworkOldAppRelaunchLog

    GenworkOldAppRelaunchProcessStateBlocked:
      StrCpy $genworkOldAppRelaunchError "process-state-not-confirmed-stopped"
      Goto GenworkOldAppRelaunchLog

    GenworkOldAppRelaunchFootprintBlocked:
      StrCpy $genworkOldAppRelaunchError "old-footprint-not-verified"

    GenworkOldAppRelaunchLog:
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=old-app-relaunch attempt_id=$genworkInstallerAttemptId status=$genworkOldAppRelaunchStatus result=$genworkOldAppRelaunchError source=$genworkOldInstallOriginalPath args=none$\r$\n"
    FileClose $9

    GenworkOldAppRelaunchDone:
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  FunctionEnd
  !macroend

  ; Restore the complete previous tree whenever a controlled installer failure
  ; occurs after the fast-path rename but before the new install is committed.
  ; Direct NSIS Quit calls bypass callbacks, so patched template exit sites call
  ; customBeforeInstallerQuit explicitly; interactive failure/cancel callbacks
  ; use the same function as a second line of defence.
  Function genworkRollbackOldInstall
    Push $0
    Push $1
    Push $2
    Push $3
    Push $4
    Push $5
    Push $6
    Push $7
    Push $8
    Push $9

    StrCmp $genworkOldInstallRenameStatus "success" GenworkRollbackEligible
    StrCmp $genworkOldInstallRenameStatus "prevalidated" 0 GenworkRollbackDone
    GenworkRollbackEligible:
    StrCpy $genworkOldInstallRollbackStatus "started"
    StrCpy $genworkOldInstallRollbackError "0"
    StrCpy $genworkOldInstallRenameStatus "rollback-in-progress"
    System::Call 'kernel32::GetTickCount()i .r7'
    System::Call 'kernel32::GetCurrentProcessId()i .r4'
    StrCpy $genworkOldInstallFailedPath "$genworkOldInstallOriginalPath.failed.$4.$7"

    InitPluginsDir
    SetOutPath "$PLUGINSDIR"

    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=old-install-rollback-start attempt_id=$genworkInstallerAttemptId reason=$genworkOldInstallRollbackReason source=$genworkOldInstallOriginalPath backup=$genworkOldInstallBackupPath displaced=$genworkOldInstallFailedPath$\r$\n"
    FileClose $9

    ; Remove an empty target directory first. If the new payload already wrote
    ; files, move the partial tree aside so the complete backup can return to
    ; the exact registered path without destructive deletion.
    RMDir "$genworkOldInstallOriginalPath"
    StrCpy $2 "false"
    System::Call 'kernel32::MoveFileW(w "$genworkOldInstallOriginalPath", w "$genworkOldInstallFailedPath") i .r0 ?e'
    Pop $1
    IntCmp $0 0 GenworkRollbackTargetMoveFailed GenworkRollbackTargetMoved GenworkRollbackTargetMoved

    GenworkRollbackTargetMoved:
      StrCpy $2 "true"
      Goto GenworkRollbackRestoreBackup

    GenworkRollbackTargetMoveFailed:
      ; ERROR_FILE_NOT_FOUND / ERROR_PATH_NOT_FOUND is expected when payload
      ; extraction had not created the target yet. The restore attempt below
      ; is the authority on whether rollback can complete.
      StrCpy $genworkOldInstallRollbackError "target-move:$1"

    GenworkRollbackRestoreBackup:
    System::Call 'kernel32::MoveFileW(w "$genworkOldInstallBackupPath", w "$genworkOldInstallOriginalPath") i .r0 ?e'
    Pop $1
    IntCmp $0 0 GenworkRollbackRestoreFailed GenworkRollbackRestoreSucceeded GenworkRollbackRestoreSucceeded

    GenworkRollbackRestoreSucceeded:
      StrCpy $genworkOldInstallRollbackStatus "success"
      StrCpy $genworkOldInstallRollbackError "0"
      StrCpy $genworkOldInstallRenameStatus "rolled-back"

      ; A failed update must not leave its broad, install-scope Defender
      ; exclusion protecting the restored application indefinitely.
      StrCmp $genworkTrustedPowerShellPath "" GenworkRollbackDefenderCleanupDone
      System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_DEFENDER_TARGET", t "$genworkOldInstallOriginalPath")i'
      nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "try { Remove-MpPreference -ExclusionPath $$env:GENWORK_DEFENDER_TARGET -ErrorAction SilentlyContinue } catch {}"'
      Pop $0
      Pop $1
      System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_DEFENDER_TARGET", t "")i'
      GenworkRollbackDefenderCleanupDone:

      ; The displaced tree is never needed after a verified restore. Pass its
      ; exact path through the child environment instead of interpolating it
      ; into cmd/PowerShell code: custom install directories may contain shell
      ; metacharacters. Exec is deliberately non-blocking.
      StrCmp $2 "true" 0 GenworkRollbackLog
      System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_FAILED_CLEANUP_PATH", t "$genworkOldInstallFailedPath")i'
      ClearErrors
      StrCmp $genworkTrustedPowerShellPath "" GenworkRollbackFailedTreeCleanupDone
      Exec '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -WindowStyle Hidden -Command "Remove-Item -LiteralPath $$env:GENWORK_FAILED_CLEANUP_PATH -Recurse -Force -ErrorAction SilentlyContinue"'
      GenworkRollbackFailedTreeCleanupDone:
      System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_FAILED_CLEANUP_PATH", t "")i'
      Goto GenworkRollbackLog

    GenworkRollbackRestoreFailed:
      StrCpy $genworkOldInstallRollbackStatus "failed"
      StrCpy $genworkOldInstallRollbackError "backup-restore:$1"
      StrCpy $genworkOldInstallRenameStatus "rollback-failed"

      ; If the partial tree was displaced but the complete backup could not be
      ; restored, put the partial tree back. Never delete either tree when the
      ; recovery state is ambiguous.
      StrCmp $2 "true" 0 GenworkRollbackLog
      System::Call 'kernel32::MoveFileW(w "$genworkOldInstallFailedPath", w "$genworkOldInstallOriginalPath") i .r0 ?e'
      Pop $3
      IntCmp $0 0 0 GenworkRollbackLog GenworkRollbackLog
      StrCpy $genworkOldInstallRollbackError "$genworkOldInstallRollbackError;partial-restore:$3"

    GenworkRollbackLog:
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7
    StrCpy $2 "false"
    StrCpy $3 "false"
    IfFileExists "$genworkOldInstallOriginalPath\*.*" 0 GenworkRollbackSourceChecked
      StrCpy $2 "true"
    GenworkRollbackSourceChecked:
    IfFileExists "$genworkOldInstallBackupPath\*.*" 0 GenworkRollbackBackupChecked
      StrCpy $3 "true"
    GenworkRollbackBackupChecked:
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=old-install-rollback-complete attempt_id=$genworkInstallerAttemptId status=$genworkOldInstallRollbackStatus reason=$genworkOldInstallRollbackReason error=$genworkOldInstallRollbackError elapsed_ms=$5 source_exists=$2 backup_exists=$3 displaced=$genworkOldInstallFailedPath$\r$\n"
    FileClose $9
    StrCmp $genworkOldInstallRollbackStatus "success" 0 GenworkRollbackDone
    Call genworkTryRelaunchOldApp

    GenworkRollbackDone:
    Pop $9
    Pop $8
    Pop $7
    Pop $6
    Pop $5
    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
  FunctionEnd

  !macro customRollbackOldInstall REASON
    StrCpy $genworkOldInstallRollbackReason "${REASON}"
    Call genworkRollbackOldInstall
  !macroend

  !macro customBeforeInstallerQuit REASON
    !insertmacro customRollbackOldInstall "${REASON}"
  !macroend

  !macro customInstallerFailed
    !insertmacro customRollbackOldInstall "installer-failed"
  !macroend

  !macro customInstallerUserAbort
    !insertmacro customRollbackOldInstall "user-abort"
  !macroend
!endif

; Replaces electron-builder's built-in CHECK_APP_RUNNING. Inserted:
;  - installer: inside the install section, right after the user confirms,
;    before uninstallOldVersion and file extraction
;  - uninstaller: un.install section (assisted) or un.onInit (silent /S)
!macro customCheckAppRunning
  !ifndef BUILD_UNINSTALLER
    ; Silent installs (/S -- e.g. enterprise IT deployments; in-app updates
    ; use --updated mode with a visible progress page instead) have no
    ; installer UI at all, so without this the machine looks idle for minutes
    ; mid-replace. Banner is a plugin-owned window, so it shows even in
    ; silent mode. The window dies with the installer process, so no failure
    ; path can leave it behind.
    ;
    ; The text is "Updating GenWork, please wait..." in Chinese, written as
    ; ${U+xxxx} escapes because this file must stay pure ASCII: the darwin
    ; makensis builds used for local syntax checks reject any non-ASCII byte
    ; (the escapes are fine on the Windows build machine -- the webPackage
    ; patch ships them in production already).
    ${If} ${Silent}
      Banner::show /NOUNLOAD "${U+6B63}${U+5728}${U+66F4}${U+65B0} GenWork${U+FF0C}${U+8BF7}${U+7A0D}${U+5019}${U+2026}"
    ${EndIf}
  !endif

  !ifndef BUILD_UNINSTALLER
    !insertmacro EnsureInstallerAttemptId
    StrCpy $genworkOldInstallOriginalPath "$INSTDIR"
    GetFullPathName $genworkOldInstallOriginalPathNormalized "$INSTDIR"
    StrCpy $genworkOldAppExecutablePath "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
    StrCpy $genworkOldUninstallerPath "$INSTDIR\${UNINSTALL_FILENAME}"
    StrCpy $genworkOldAppAsarPath "$INSTDIR\resources\app.asar"
    StrCpy $genworkOldInstallRegisteredPath ""
    StrCpy $genworkOldInstallRegisteredPathNormalized ""
    StrCpy $genworkOldInstallAlternateRegisteredPath ""
    StrCpy $genworkOldInstallAlternateRegisteredPathNormalized ""
    StrCpy $genworkOldInstallBackupPath ""
    StrCpy $genworkOldInstallFailedPath ""
    StrCpy $genworkOldInstallRenameStatus "preflight"
    StrCpy $genworkOldInstallRenameReason "not-evaluated"
    StrCpy $genworkOldInstallRenameError "0"
    StrCpy $genworkOldInstallRenameAttempts "0"
    StrCpy $genworkOldInstallRollbackReason ""
    StrCpy $genworkOldInstallRollbackStatus "not-needed"
    StrCpy $genworkOldInstallRollbackError "0"
    StrCpy $genworkNewInstallValidationStatus "not-started"
    StrCpy $genworkNewInstallValidationReason "not-evaluated"
    StrCpy $genworkTargetProcessesStopStatus "not-started"
    StrCpy $genworkLegacySkillsStatus "not-inspected"
    StrCpy $genworkLegacySkillsRestoreStatus "not-required"
    StrCpy $genworkOldAppRelaunchStatus "not-attempted"
    StrCpy $genworkOldAppRelaunchError "none"

    ; The fresh decision is read-only and precedes every external helper,
    ; process stop, legacy Skills action, old uninstaller and directory rename.
    !insertmacro DetectFreshOrPossibleExisting
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=install-preflight-complete attempt_id=$genworkInstallerAttemptId installer_version=${VERSION} invocation_source=$genworkInvocationSource updated_flag=$genworkUpdatedFlag ui_mode=$genworkUiMode launcher_fallback=$genworkLauncherFallback scenario=$genworkInstallScenario instdir=$INSTDIR$\r$\n"
    FileClose $9

    StrCmp $genworkInstallScenario "fresh-install" CustomCheckFreshInstall

    ; Record the legacy source with a native, non-following attribute check
    ; before any external helper or process stop. This is advisory only: an
    ; existing installation still has to stop its processes even when the
    ; legacy source is absent, and the source is checked again after the stop
    ; before any backup is authorized.
    StrCpy $genworkLegacySkillsStatus "legacy-source-present"
    System::Call 'kernel32::GetFileAttributesW(w "$INSTDIR\resources\SKILLs") i .r0'
    IntCmp $0 -1 LegacySkillsSourcePreflightAbsent 0 0
    IntOp $1 $0 & 0x10
    IntCmp $1 0 LegacySkillsSourcePreflightInvalid LegacySkillsSourcePreflightDirectory LegacySkillsSourcePreflightDirectory
    LegacySkillsSourcePreflightDirectory:
    IntOp $1 $0 & 0x400
    IntCmp $1 0 LegacySkillsSourcePreflightLogged LegacySkillsSourcePreflightInvalid LegacySkillsSourcePreflightInvalid
    LegacySkillsSourcePreflightAbsent:
      StrCpy $genworkLegacySkillsStatus "legacy-source-not-present"
      Goto LegacySkillsSourcePreflightLogged
    LegacySkillsSourcePreflightInvalid:
      StrCpy $genworkLegacySkillsStatus "legacy-source-invalid"
    LegacySkillsSourcePreflightLogged:
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=legacy-skills-source-preflight attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsStatus source=$INSTDIR\resources\SKILLs$\r$\n"
    FileClose $9

    !insertmacro ResolveTrustedPowerShell
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=system-tool-resolved attempt_id=$genworkInstallerAttemptId tool=powershell status=$genworkTrustedPowerShellStatus source=$genworkTrustedPowerShellSource path=$genworkTrustedPowerShellPath$\r$\n"
    FileClose $9

    !insertmacro stopGenWorkProcesses
    StrCmp $genworkTargetProcessesStopStatus "success" TargetProcessesStopped
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=install-failed-before-mutation attempt_id=$genworkInstallerAttemptId failure_kind=process-stop-failed raw_status=$genworkTargetProcessesStopStatus exit=$R2 action=old-install-untouched$\r$\n"
      FileClose $9
      ${If} ${Silent}
        Banner::destroy
      ${EndIf}
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update stopped before replacing the previous version because the old application processes could not be confirmed stopped. Please close GenWork and retry. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      SetErrorLevel 2
      Quit
    TargetProcessesStopped:

    ; -- Backup user-created skills to AppData before extraction overwrites them --
    ; Copy non-bundled skills to %APPDATA%\GenWork\skills-backup\ so they are
    ; preserved when NSIS extracts the new version over the existing install.
    ; The backup is restored in customInstall after extraction completes.
    ; Must run before the $INSTDIR rename below -- it reads from $INSTDIR.
    ;
    ; Quoting note: paths use \"..\" (backslash-escaped quote) -- NOT $\"..$\" --
    ; because $\"..$\" produces raw quotes that Windows CRT argv parsing consumes,
    ; leaving the path unquoted and causing PowerShell method calls to fail.
    ; A missing legacy source is an allowed result and never launches
    ; PowerShell. Empty-but-present directories still go through inspection.
    System::Call 'kernel32::GetTickCount()i .r7'
    System::Call 'kernel32::GetFileAttributesW(w "$INSTDIR\resources\SKILLs") i .r0'
    IntCmp $0 -1 SkillBackupSourceAbsent 0 0
    IntOp $1 $0 & 0x10
    IntCmp $1 0 SkillBackupInspectFailed SkillBackupSourceTypeReady SkillBackupSourceTypeReady
    SkillBackupSourceTypeReady:
    IntOp $1 $0 & 0x400
    IntCmp $1 0 SkillBackupSourceReady SkillBackupInspectFailed SkillBackupInspectFailed

    SkillBackupSourceAbsent:
      StrCpy $genworkLegacySkillsStatus "legacy-source-not-present"
      StrCpy $R2 "0"
      Goto SkillBackupResultLog

    SkillBackupInspectFailed:
      StrCpy $genworkLegacySkillsStatus "legacy-inspect-failed"
      StrCpy $R2 "invalid-source-attributes"
      Goto SkillBackupResultLog

    SkillBackupSourceReady:
    DetailPrint "[Installer] Backing up user-created skills"
    ClearErrors
    FileOpen $R0 "$APPDATA\GenWork\skill-migrate.log" w
    IfErrors BackupLogOpenFailed
      !insertmacro GetTimestamp $8
      FileWrite $R0 "$8 phase=backup-start attempt_id=$genworkInstallerAttemptId instdir=$INSTDIR appdata=$APPDATA$\r$\n"
      Goto BackupDoExec
    BackupLogOpenFailed:
      StrCpy $R0 ""
    BackupDoExec:

    ReadRegStr $4 SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" DisplayVersion
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_SOURCE", t "$INSTDIR\resources\SKILLs")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_BACKUP_ROOT", t "$APPDATA\GenWork\skills-backup")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ATTEMPT_ID", t "$genworkInstallerAttemptId")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_OLD_VERSION", t "$4")i'
    nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
      $$ErrorActionPreference = \"Stop\";\
      $$src       = $$env:GENWORK_SKILL_SOURCE;\
      $$root      = $$env:GENWORK_SKILL_BACKUP_ROOT;\
      $$attempt   = $$env:GENWORK_INSTALL_ATTEMPT_ID;\
      $$oldVer    = $$env:GENWORK_OLD_VERSION;\
      $$backup    = Join-Path $$root $$attempt;\
      $$staging   = $$backup + \".new\";\
      $$manifest  = Join-Path $$staging \"backup-manifest.json\";\
      $$config    = Join-Path $$src \"skills.config.json\";\
      $$phase   = \"inspect\";\
      try {\
        if ([string]::IsNullOrWhiteSpace($$attempt)) { throw \"attempt id missing\" };\
        if (-not (Test-Path -LiteralPath $$src -PathType Container)) { throw \"legacy source disappeared\" };\
        $$bundled = @(try {\
          if (Test-Path -LiteralPath $$config -PathType Leaf) {\
            (Get-Content -LiteralPath $$config -Raw | ConvertFrom-Json).defaults.PSObject.Properties.Name\
          }\
        } catch { });\
        $$userSkills = @(Get-ChildItem -LiteralPath $$src -Directory -ErrorAction Stop | Where-Object { $$bundled -notcontains $$_.Name });\
        if ($$userSkills.Count -eq 0) { Write-Output \"legacy-no-user-skills\"; exit ${GENWORK_SKILL_BACKUP_EXIT_NO_USER_SKILLS} };\
        $$phase = \"backup-copy\";\
        if (Test-Path -LiteralPath $$staging) { Remove-Item -LiteralPath $$staging -Recurse -Force -ErrorAction Stop };\
        if (Test-Path -LiteralPath $$backup) { throw \"attempt backup already exists\" };\
        New-Item -ItemType Directory -Path $$staging -Force -ErrorAction Stop | Out-Null;\
        $$userSkills | ForEach-Object {\
          Copy-Item -LiteralPath $$_.FullName -Destination (Join-Path $$staging $$_.Name) -Recurse -Force -ErrorAction Stop\
        };\
        Set-Content -LiteralPath (Join-Path $$staging \".attempt-id\") -Value $$attempt -NoNewline -ErrorAction Stop;\
        $$directories = @(Get-ChildItem -LiteralPath $$staging -Directory -Recurse -Force -ErrorAction Stop | Sort-Object FullName | ForEach-Object {\
          $$_.FullName.Substring($$staging.Length).TrimStart([IO.Path]::DirectorySeparatorChar).Replace([IO.Path]::DirectorySeparatorChar, [char]47)\
        });\
        $$files = @(Get-ChildItem -LiteralPath $$staging -File -Recurse -Force -ErrorAction Stop | Where-Object { $$_.Name -ne \"backup-manifest.json\" } | Sort-Object FullName | ForEach-Object {\
          [ordered]@{\
            path = $$_.FullName.Substring($$staging.Length).TrimStart([IO.Path]::DirectorySeparatorChar).Replace([IO.Path]::DirectorySeparatorChar, [char]47);\
            length = $$_.Length;\
            sha256 = (Get-FileHash -LiteralPath $$_.FullName -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant()\
          }\
        });\
        $$payload = [ordered]@{\
          schemaVersion = 1;\
          attemptId = $$attempt;\
          source = $$src;\
          oldVersion = $$oldVer;\
          createdAt = (Get-Date).ToUniversalTime().ToString(\"o\");\
          skills = @($$userSkills.Name | Sort-Object);\
          directories = $$directories;\
          files = $$files;\
          statistics = [ordered]@{\
            skillCount = $$userSkills.Count;\
            directoryCount = $$directories.Count;\
            fileCount = $$files.Count;\
            totalBytes = [long](($$files | Measure-Object -Property length -Sum).Sum)\
          };\
          validation = [ordered]@{ status = \"created\"; algorithm = \"SHA256\" }\
        };\
        $$payload | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $$manifest -Encoding UTF8 -ErrorAction Stop;\
        Move-Item -LiteralPath $$staging -Destination $$backup -ErrorAction Stop;\
        $$phase = \"backup-verify\";\
        $$manifest = Join-Path $$backup \"backup-manifest.json\";\
        $$verified = Get-Content -LiteralPath $$manifest -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop;\
        if ($$verified.schemaVersion -ne 1) { throw \"manifest schema mismatch\" };\
        if ($$verified.attemptId -ne $$attempt) { throw \"manifest attempt mismatch\" };\
        if ($$verified.source -ne $$src) { throw \"manifest source mismatch\" };\
        if (@($$verified.skills).Count -ne $$userSkills.Count) { throw \"manifest skill count mismatch\" };\
        foreach ($$skill in @($$verified.skills)) {\
          if (-not (Test-Path -LiteralPath (Join-Path $$backup $$skill) -PathType Container)) { throw \"manifest skill missing\" }\
        };\
        foreach ($$file in @($$verified.files)) {\
          $$candidate = Join-Path $$backup ($$file.path.Replace([char]47, [IO.Path]::DirectorySeparatorChar));\
          if (-not (Test-Path -LiteralPath $$candidate -PathType Leaf)) { throw \"manifest file missing\" };\
          if ((Get-FileHash -LiteralPath $$candidate -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant() -ne $$file.sha256) { throw \"manifest hash mismatch\" }\
        };\
        $$verified.validation.status = \"verified\";\
        $$verified.validation | Add-Member -NotePropertyName verifiedAt -NotePropertyValue ((Get-Date).ToUniversalTime().ToString(\"o\")) -Force;\
        $$verified | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $$manifest -Encoding UTF8 -ErrorAction Stop;\
        $$finalManifest = Get-Content -LiteralPath $$manifest -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop;\
        if (($$finalManifest.attemptId -ne $$attempt) -or ($$finalManifest.validation.status -ne \"verified\")) { throw \"manifest final validation mismatch\" };\
        Write-Output (\"legacy-backup-succeeded skills=\" + $$finalManifest.statistics.skillCount + \" files=\" + $$finalManifest.statistics.fileCount + \" directories=\" + $$finalManifest.statistics.directoryCount + \" bytes=\" + $$finalManifest.statistics.totalBytes);\
        exit ${GENWORK_SKILL_BACKUP_EXIT_VERIFIED}\
      } catch {\
        if (Test-Path -LiteralPath $$staging) { Remove-Item -LiteralPath $$staging -Recurse -Force -ErrorAction SilentlyContinue };\
        if ($$phase -eq \"inspect\") { Write-Output \"legacy-inspect-failed\"; exit ${GENWORK_SKILL_BACKUP_EXIT_INSPECT_FAILED} };\
        if ($$phase -eq \"backup-verify\") { Write-Output \"legacy-backup-verify-failed\"; exit ${GENWORK_SKILL_BACKUP_EXIT_VERIFY_FAILED} };\
        Write-Output \"legacy-backup-copy-failed\";\
        exit ${GENWORK_SKILL_BACKUP_EXIT_COPY_FAILED}\
      }"'
    Pop $0
    Pop $1
    StrCpy $R2 $0
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_SOURCE", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_BACKUP_ROOT", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ATTEMPT_ID", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_OLD_VERSION", t "")i'
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7

    StrCmp $R0 "" BackupSkipCloseLog
      !insertmacro GetTimestamp $8
      FileWrite $R0 "$8 phase=backup-end attempt_id=$genworkInstallerAttemptId exit=$R2 elapsed_ms=$5$\r$\n"
      FileWrite $R0 "$8 phase=backup-output attempt_id=$genworkInstallerAttemptId text=$1$\r$\n"
      FileClose $R0
    BackupSkipCloseLog:
    ; Status is derived from the helper exit code alone. stdout ($1) is
    ; logged above for diagnosis only: ExecToStack keeps the helper's
    ; trailing CRLF, so an exact text match here silently fails. Unknown
    ; exit codes keep the fail-closed copy-failed default.
    StrCpy $genworkLegacySkillsStatus "legacy-backup-copy-failed"
    StrCmp $R2 "error" 0 +3
      StrCpy $genworkLegacySkillsStatus "legacy-helper-launch-failed"
      Goto SkillBackupResultLog
    StrCmp $R2 "${GENWORK_SKILL_BACKUP_EXIT_VERIFIED}" 0 +3
      StrCpy $genworkLegacySkillsStatus "legacy-backup-succeeded"
      Goto SkillBackupResultLog
    StrCmp $R2 "${GENWORK_SKILL_BACKUP_EXIT_NO_USER_SKILLS}" 0 +3
      StrCpy $genworkLegacySkillsStatus "legacy-no-user-skills"
      Goto SkillBackupResultLog
    StrCmp $R2 "${GENWORK_SKILL_BACKUP_EXIT_INSPECT_FAILED}" 0 +2
      StrCpy $genworkLegacySkillsStatus "legacy-inspect-failed"
    StrCmp $R2 "${GENWORK_SKILL_BACKUP_EXIT_COPY_FAILED}" 0 +2
      StrCpy $genworkLegacySkillsStatus "legacy-backup-copy-failed"
    StrCmp $R2 "${GENWORK_SKILL_BACKUP_EXIT_VERIFY_FAILED}" 0 +2
      StrCpy $genworkLegacySkillsStatus "legacy-backup-verify-failed"

    SkillBackupResultLog:
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=skill-backup-complete attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsStatus exit=$R2 elapsed_ms=$5 backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
    FileClose $9

    ; User-created skills live inside the installation tree. If their backup
    ; did not complete, stop before the directory swap so the only authoritative
    ; copy remains untouched. An update that fails closed is recoverable; a
    ; fast update that silently drops user data is not.
    StrCmp $genworkLegacySkillsStatus "legacy-source-not-present" SkillBackupValidated
    StrCmp $genworkLegacySkillsStatus "legacy-no-user-skills" SkillBackupValidated
    StrCmp $genworkLegacySkillsStatus "legacy-backup-succeeded" 0 SkillBackupFailedAbort
      ; Post-condition for a verified backup: the manifest must still exist on
      ; disk immediately before any destructive step. If it vanished (e.g.
      ; antivirus quarantine), fail closed now while the old install is still
      ; intact instead of discovering the loss at restore time.
      IfFileExists "$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId\backup-manifest.json" SkillBackupValidated
      StrCpy $genworkLegacySkillsStatus "legacy-backup-verify-failed"
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=skill-backup-manifest-postcheck-missing attempt_id=$genworkInstallerAttemptId manifest=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId\backup-manifest.json$\r$\n"
      FileClose $9
    SkillBackupFailedAbort:
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=skill-backup-failed-abort attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsStatus exit=$R2 action=old-install-preserved$\r$\n"
      FileClose $9
      Call genworkTryRelaunchOldApp
      ${If} ${Silent}
        Banner::destroy
      ${EndIf}
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update stopped because legacy user skills could not be safely inspected or backed up (status=$genworkLegacySkillsStatus). The previous installation was not replaced. Please retry the update. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      SetErrorLevel 2
      Quit
    SkillBackupValidated:

    ; -- Move the previous installation out of the target path --
    ;
    ; electron-builder's .onInit calls SetOutPath $INSTDIR. On Windows that
    ; makes $INSTDIR the installer's current directory, which prevents the
    ; directory itself from being renamed. Move the current directory to the
    ; plugin temp directory before attempting the update fast path.
    ;
    ; The fast path is deliberately limited to an in-app update whose selected
    ; registry root owns this exact install directory. Manual reinstalls and
    ; ambiguous/mismatched installs retain electron-builder's old-uninstaller
    ; fallback. A successful backup is not deleted until customInstall runs,
    ; so extraction does not compete with a recursive old-tree deletion.
    DetailPrint "[Installer] Preparing previous installation for replacement"
    System::Call 'kernel32::GetTickCount()i .r7'
    StrCpy $genworkOldInstallOriginalPath "$INSTDIR"
    GetFullPathName $genworkOldInstallOriginalPathNormalized "$INSTDIR"
    StrCpy $genworkOldInstallRegisteredPath ""
    StrCpy $genworkOldInstallRegisteredPathNormalized ""
    StrCpy $genworkOldInstallAlternateRegisteredPath ""
    StrCpy $genworkOldInstallAlternateRegisteredPathNormalized ""
    StrCpy $genworkOldInstallBackupPath ""
    StrCpy $genworkOldInstallFailedPath ""
    StrCpy $genworkOldInstallRenameStatus "not-applicable"
    StrCpy $genworkOldInstallRenameReason "not-updated"
    StrCpy $genworkOldInstallRenameError "0"
    StrCpy $genworkOldInstallRenameAttempts "0"
    StrCpy $genworkOldInstallRollbackReason ""
    StrCpy $genworkOldInstallRollbackStatus "not-needed"
    StrCpy $genworkOldInstallRollbackError "0"

    ClearErrors
    ReadRegStr $genworkOldInstallRegisteredPath SHELL_CONTEXT "${INSTALL_REGISTRY_KEY}" InstallLocation
    StrCmp $genworkOldInstallRegisteredPath "" OldInstallRegisteredPathReady
      GetFullPathName $genworkOldInstallRegisteredPathNormalized "$genworkOldInstallRegisteredPath"
    OldInstallRegisteredPathReady:

    GetFullPathName $genworkOldInstallCurrentDirectory "."
    InitPluginsDir
    SetOutPath "$PLUGINSDIR"

    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=old-install-rename-start attempt_id=$genworkInstallerAttemptId instdir=$genworkOldInstallOriginalPath registered_instdir=$genworkOldInstallRegisteredPath current_directory=$genworkOldInstallCurrentDirectory install_mode=$installMode$\r$\n"
    FileClose $9

    ${IfNot} ${isUpdated}
      Goto OldInstallRenameComplete
    ${EndIf}

    StrCpy $genworkOldInstallRenameReason "registered-install-missing"
    StrCmp $genworkOldInstallRegisteredPathNormalized "" OldInstallRenameComplete

    StrCpy $genworkOldInstallRenameReason "install-location-mismatch"
    StrCmp $genworkOldInstallRegisteredPathNormalized $genworkOldInstallOriginalPathNormalized 0 OldInstallRenameComplete

    ; A machine install can have a stale per-user registration pointing at the
    ; same directory. Fast-path skipping both roots would preserve a duplicate
    ; Add/Remove Programs entry whose uninstaller targets the live machine
    ; install, so treat this ambiguous state as fallback-only.
    ${If} $installMode == "all"
      ClearErrors
      ReadRegStr $genworkOldInstallAlternateRegisteredPath HKEY_CURRENT_USER "${INSTALL_REGISTRY_KEY}" InstallLocation
      StrCmp $genworkOldInstallAlternateRegisteredPath "" OldInstallAlternateRegisteredPathReady
        GetFullPathName $genworkOldInstallAlternateRegisteredPathNormalized "$genworkOldInstallAlternateRegisteredPath"
      OldInstallAlternateRegisteredPathReady:
      StrCpy $genworkOldInstallRenameReason "ambiguous-dual-registration"
      StrCmp $genworkOldInstallAlternateRegisteredPathNormalized $genworkOldInstallOriginalPathNormalized OldInstallRenameComplete
    ${EndIf}

    StrCpy $genworkOldInstallRenameReason "install-files-missing"
    IfFileExists "$genworkOldInstallOriginalPath\${APP_EXECUTABLE_FILENAME}" OldInstallRenameEligible
    IfFileExists "$genworkOldInstallOriginalPath\${UNINSTALL_FILENAME}" OldInstallRenameEligible
    Goto OldInstallRenameComplete

    OldInstallRenameEligible:
      StrCpy $genworkOldInstallRenameStatus "failed"
      StrCpy $genworkOldInstallRenameReason "rename-failed"
      System::Call 'kernel32::GetCurrentProcessId()i .r4'
      StrCpy $genworkCurrentProcessPid $4
      System::Call 'kernel32::GetTickCount()i .r4'
      StrCpy $genworkOldInstallBackupPath "$genworkOldInstallOriginalPath.old.$genworkCurrentProcessPid.$4"

    OldInstallRenameAttempt:
      IntOp $genworkOldInstallRenameAttempts $genworkOldInstallRenameAttempts + 1
      ; Capture the Win32 error in the same System plug-in invocation as the
      ; move. GetLastError after an NSIS Rename/logging call can be stale.
      System::Call 'kernel32::MoveFileW(w "$genworkOldInstallOriginalPath", w "$genworkOldInstallBackupPath") i .r4 ?e'
      Pop $genworkOldInstallRenameError
      IntCmp $4 0 OldInstallRenameAttemptFailed OldInstallRenameAttemptSucceeded OldInstallRenameAttemptSucceeded

    OldInstallRenameAttemptSucceeded:
      StrCpy $genworkOldInstallRenameStatus "success"

      ; Rename success is only accepted when the source tree is gone and the
      ; complete backup tree is visible at the unique destination.
      IfFileExists "$genworkOldInstallOriginalPath\*.*" OldInstallRenameVerificationFailed
      IfFileExists "$genworkOldInstallBackupPath\*.*" 0 OldInstallRenameVerificationFailed
      StrCpy $genworkOldInstallRenameStatus "success"
      StrCpy $genworkOldInstallRenameReason "renamed"
      StrCpy $genworkOldInstallRenameError "0"
      Goto OldInstallRenameComplete

    OldInstallRenameAttemptFailed:
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-install-rename-attempt attempt_id=$genworkInstallerAttemptId attempt=$genworkOldInstallRenameAttempts result=failed win32_error=$genworkOldInstallRenameError$\r$\n"
      FileClose $9
      IntCmp $genworkOldInstallRenameAttempts 3 OldInstallRenameComplete OldInstallRenameRetry OldInstallRenameComplete

    OldInstallRenameRetry:
      Sleep 250
      Goto OldInstallRenameAttempt

    OldInstallRenameVerificationFailed:
      StrCpy $genworkOldInstallRenameReason "verification-failed"
      StrCpy $genworkOldInstallRenameError "verification-failed"
      !insertmacro customRollbackOldInstall "rename-verification-failed"
      StrCmp $genworkOldInstallRollbackStatus "success" OldInstallRenameVerificationRestored

      ; The move succeeded but its postcondition could not be verified, and
      ; rollback could not restore a single authoritative old tree. Freeze the
      ; attempt with every recovery source preserved; never fall through into
      ; stock uninstall/install while filesystem ownership is ambiguous.
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-install-rename-verification-abort attempt_id=$genworkInstallerAttemptId outcome=recovery-required rollback_status=$genworkOldInstallRollbackStatus rollback_error=$genworkOldInstallRollbackError source=$genworkOldInstallOriginalPath backup=$genworkOldInstallBackupPath$\r$\n"
      FileClose $9
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update stopped because the previous installation move could not be verified and automatic recovery did not complete. No recovery copy was deleted. Restart Windows before retrying. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      ${If} ${Silent}
        Banner::destroy
      ${EndIf}
      SetErrorLevel 3
      Quit

    OldInstallRenameVerificationRestored:
      ; genworkRollbackOldInstall has already restored and, when its strict
      ; gates allow it, relaunched the old application. This attempt must end
      ; here instead of invoking the stock uninstaller against that live tree.
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-install-rename-verification-abort attempt_id=$genworkInstallerAttemptId outcome=restored rollback_status=$genworkOldInstallRollbackStatus relaunch_status=$genworkOldAppRelaunchStatus source=$genworkOldInstallOriginalPath$\r$\n"
      FileClose $9
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update stopped because the previous installation move could not be verified. The previous version was restored. Please retry the update. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      ${If} ${Silent}
        Banner::destroy
      ${EndIf}
      SetErrorLevel 2
      Quit

    OldInstallRenameComplete:
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7
    StrCpy $2 "false"
    StrCpy $3 "false"
    IfFileExists "$genworkOldInstallOriginalPath\*.*" 0 OldInstallRenameSourceChecked
      StrCpy $2 "true"
    OldInstallRenameSourceChecked:
    StrCmp $genworkOldInstallBackupPath "" OldInstallRenameBackupChecked
    IfFileExists "$genworkOldInstallBackupPath\*.*" 0 OldInstallRenameBackupChecked
      StrCpy $3 "true"
    OldInstallRenameBackupChecked:
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=old-install-rename-complete attempt_id=$genworkInstallerAttemptId status=$genworkOldInstallRenameStatus reason=$genworkOldInstallRenameReason attempts=$genworkOldInstallRenameAttempts win32_error=$genworkOldInstallRenameError elapsed_ms=$5 source_exists=$2 backup_exists=$3 backup_path=$genworkOldInstallBackupPath cleanup_mode=deferred$\r$\n"
    FileClose $9

    ; The install-scope Defender exclusion is intentionally added by
    ; customAfterUninstallOldVersions, after every legacy uninstaller has
    ; returned. Older uninstallers remove these exclusions during --updated;
    ; adding here would let them undo the protection before payload extraction.
    Goto CustomCheckInstallerDone

    CustomCheckFreshInstall:
      StrCpy $genworkTargetProcessesStopStatus "not-required-fresh-install"
      StrCpy $genworkLegacySkillsStatus "legacy-not-applicable-fresh-install"
      StrCpy $genworkOldInstallRenameStatus "not-required"
      StrCpy $genworkOldInstallRenameReason "fresh-install"
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=fresh-install-old-flow-skipped attempt_id=$genworkInstallerAttemptId process_stop=skipped legacy_skills=skipped old_staging=skipped$\r$\n"
      FileClose $9

    CustomCheckInstallerDone:
  !else
    ; Uninstall remains best-effort when PowerShell is unavailable. It uses the
    ; same absolute resolver but does not turn an optional process stop into an
    ; uninstall blocker.
    !insertmacro EnsureInstallerAttemptId
    !insertmacro ResolveTrustedPowerShell
    !insertmacro stopGenWorkProcesses
  !endif
!macroend

!ifndef BUILD_UNINSTALLER
  ; electron-builder delegates each registry root to this wrapper. A successful
  ; fast-path rename is matched against that root's InstallLocation explicitly;
  ; only the matching legacy uninstaller is skipped. Every other case retains
  ; the stock uninstallOldVersion fallback and its error handling.
  !macro customUninstallOldVersion ROOT_KEY
    StrCpy $genworkOldUninstallCandidatePath ""
    StrCpy $genworkOldUninstallCandidatePathNormalized ""
    ClearErrors
    !insertmacro readReg $genworkOldUninstallCandidatePath ${ROOT_KEY} "${INSTALL_REGISTRY_KEY}" InstallLocation
    StrCmp $genworkOldUninstallCandidatePath "" CustomOldUninstallCandidateReady_${ROOT_KEY}
      GetFullPathName $genworkOldUninstallCandidatePathNormalized "$genworkOldUninstallCandidatePath"
    CustomOldUninstallCandidateReady_${ROOT_KEY}:

    ${If} $genworkOldInstallRenameStatus == "success"
    ${AndIf} $genworkOldUninstallCandidatePathNormalized != ""
    ${AndIf} $genworkOldUninstallCandidatePathNormalized == $genworkOldInstallOriginalPathNormalized
      ClearErrors
      StrCpy $R0 0
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-uninstaller-skipped attempt_id=$genworkInstallerAttemptId root=${ROOT_KEY} reason=rename-success registered_instdir=$genworkOldUninstallCandidatePath backup_path=$genworkOldInstallBackupPath$\r$\n"
      FileClose $9
    ${Else}
      System::Call 'kernel32::GetTickCount()i .r4'
      StrCpy $genworkOldUninstallStartTick $4
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-uninstaller-start attempt_id=$genworkInstallerAttemptId root=${ROOT_KEY} registered_instdir=$genworkOldUninstallCandidatePath rename_status=$genworkOldInstallRenameStatus$\r$\n"
      FileClose $9

      !insertmacro uninstallOldVersion ${ROOT_KEY}
      IfErrors CustomOldUninstallerLaunchFailed_${ROOT_KEY}
      StrCpy $genworkOldUninstallLaunchStatus "returned"
      Goto CustomOldUninstallerReturned_${ROOT_KEY}

      CustomOldUninstallerLaunchFailed_${ROOT_KEY}:
      StrCpy $genworkOldUninstallLaunchStatus "launch-error"

      CustomOldUninstallerReturned_${ROOT_KEY}:
      System::Call 'kernel32::GetTickCount()i .r6'
      IntOp $5 $6 - $genworkOldUninstallStartTick
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-uninstaller-returned attempt_id=$genworkInstallerAttemptId root=${ROOT_KEY} status=$genworkOldUninstallLaunchStatus exit=$R0 elapsed_ms=$5$\r$\n"
      FileClose $9

      ; handleUninstallResult calls Quit for a non-zero legacy uninstaller.
      ; Roll the fast-path directory swap back before handing it that result.
      ${If} $R0 != 0
        !insertmacro customRollbackOldInstall "old-uninstaller-nonzero"
      ${EndIf}

      ; The diagnostic writes above can change NSIS' error flag. Recreate the
      ; exact result expected by electron-builder's stock handler.
      StrCmp $genworkOldUninstallLaunchStatus "launch-error" CustomOldUninstallerRestoreError_${ROOT_KEY}
      ClearErrors
      Goto CustomOldUninstallerHandle_${ROOT_KEY}
      CustomOldUninstallerRestoreError_${ROOT_KEY}:
      SetErrors
      CustomOldUninstallerHandle_${ROOT_KEY}:
      !insertmacro handleUninstallResult ${ROOT_KEY}

      System::Call 'kernel32::GetTickCount()i .r6'
      IntOp $5 $6 - $genworkOldUninstallStartTick
      FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $9 0 END
      !insertmacro GetTimestamp $8
      FileWrite $9 "$8 phase=old-uninstaller-complete attempt_id=$genworkInstallerAttemptId root=${ROOT_KEY} status=handled exit=$R0 elapsed_ms=$5$\r$\n"
      FileClose $9
    ${EndIf}
  !macroend

  ; Runs after every old-install root has either been skipped or fully
  ; uninstalled, immediately before installApplicationFiles. This ordering is
  ; important for transition upgrades: already-installed legacy uninstallers
  ; remove GenWork exclusions at the end of their --updated flow.
  !macro customAfterUninstallOldVersions
    DetailPrint "[Installer] Applying Windows Defender install-scope exclusion"
    !insertmacro ResolveTrustedPowerShell
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=defender-exclusion-start attempt_id=$genworkInstallerAttemptId point=post-old-uninstaller rename_status=$genworkOldInstallRenameStatus helper_status=$genworkTrustedPowerShellStatus$\r$\n"
    FileClose $9
    System::Call 'kernel32::GetTickCount()i .r7'
    StrCmp $genworkTrustedPowerShellPath "" DefenderPostUninstallHelperMissing

    ${GetParameters} $R9
    ClearErrors
    ${GetOptions} $R9 "/NoDefenderExclusion" $R8
    IfErrors 0 DefenderPostUninstallQueryOnly

    CreateDirectory "$INSTDIR"
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "$INSTDIR")i'
    nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
      $$target = $$env:GENWORK_INSTALL_ROOT;\
      try { $$beforePaths = @((Get-MpPreference -ErrorAction Stop).ExclusionPath); $$before = if ($$beforePaths -contains $$target) { \"present\" } else { \"absent\" } } catch { $$before = \"query-failed\" };\
      try { Add-MpPreference -ExclusionPath $$target -ErrorAction Stop; $$add = \"added\" } catch { $$add = \"skipped:\" + $$_.Exception.Message.Trim() };\
      try { $$afterPaths = @((Get-MpPreference -ErrorAction Stop).ExclusionPath); $$after = if ($$afterPaths -contains $$target) { \"present\" } else { \"absent\" } } catch { $$after = \"query-failed\" };\
      Write-Output (\"before=\" + $$before + \" add=\" + $$add + \" after=\" + $$after)"'
    Goto DefenderPostUninstallCommandDone

    DefenderPostUninstallQueryOnly:
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "$INSTDIR")i'
    nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
      $$root = $$env:GENWORK_INSTALL_ROOT;\
      $$targets = @($$root, (Join-Path $$root \"resources\openclaw-runtime\"), (Join-Path $$root \"resources\python-win\"), (Join-Path $$root \"resources\SKILLs\"), (Join-Path $$root \"resources\app.asar.unpacked\"), (Join-Path $$root \"resources\app.asar\"), (Join-Path $$root \"resources\win-resources.tar\"));\
      try { $$beforePaths = @((Get-MpPreference -ErrorAction Stop).ExclusionPath); $$before = @($$targets | Where-Object { $$beforePaths -contains $$_ }).Count } catch { $$before = \"query-failed\" };\
      try { Remove-MpPreference -ExclusionPath $$targets -ErrorAction Stop; $$remove = \"requested\" } catch { $$remove = \"failed:\" + $$_.Exception.Message.Trim() };\
      try { $$afterPaths = @((Get-MpPreference -ErrorAction Stop).ExclusionPath); $$after = @($$targets | Where-Object { $$afterPaths -contains $$_ }).Count } catch { $$after = \"query-failed\" };\
      Write-Output (\"before_count=\" + $$before + \" add=disabled remove=\" + $$remove + \" after_count=\" + $$after)"'

    DefenderPostUninstallCommandDone:
    Pop $0
    Pop $1
    StrCpy $R2 $0
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "")i'
    Goto DefenderPostUninstallLog

    DefenderPostUninstallHelperMissing:
    StrCpy $R2 "helper-not-found"
    StrCpy $1 "skipped:trusted-powershell-unavailable"

    DefenderPostUninstallLog:
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=defender-exclusion-complete attempt_id=$genworkInstallerAttemptId point=post-old-uninstaller exit=$R2 elapsed_ms=$5 output=$1$\r$\n"
    FileClose $9
  !macroend

  ; The remaining hooks are invoked from the version-pinned app-builder-lib
  ; template patch. They use only built-in timing/file operations so the
  ; diagnostics do not add more security-scanned child processes.
  !macro customAppPackageMaterializeStart
    Push $0
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    StrCpy $genworkPackageMaterializeStartTick $0
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-materialize-start attempt_id=$genworkInstallerAttemptId arch=$packageArch dest=$PLUGINSDIR\app-$packageArch.${COMPRESSION_METHOD}$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $0
  !macroend

  !macro customAppPackageMaterializeEnd
    Push $0
    Push $1
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    IntOp $1 $0 - $genworkPackageMaterializeStartTick
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-materialize-complete attempt_id=$genworkInstallerAttemptId arch=$packageArch elapsed_ms=$1$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  !macroend

  !macro customAppPackageExtractStart MODE SOURCE
    Push $0
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    StrCpy $genworkPackageExtractStartTick $0
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-7z-extract-start attempt_id=$genworkInstallerAttemptId mode=${MODE} arch=$packageArch source=${SOURCE} dest=$OUTDIR$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $0
  !macroend

  !macro customAppPackageExtractEnd MODE RESULT
    Push $0
    Push $1
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    IntOp $1 $0 - $genworkPackageExtractStartTick
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-7z-extract-complete attempt_id=$genworkInstallerAttemptId mode=${MODE} arch=$packageArch result=${RESULT} elapsed_ms=$1$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  !macroend

  !macro customAppPackageCopyStart
    Push $0
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    StrCpy $genworkPackageCopyStartTick $0
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-copy-start attempt_id=$genworkInstallerAttemptId attempt=$R1 source=$PLUGINSDIR\7z-out dest=$OUTDIR$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $0
  !macroend

  !macro customAppPackageCopyEnd RESULT
    Push $0
    Push $1
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    IntOp $1 $0 - $genworkPackageCopyStartTick
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=payload-copy-complete attempt_id=$genworkInstallerAttemptId attempt=$R1 result=${RESULT} elapsed_ms=$1$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  !macroend

  !macro customInstallerCacheCopyStart KIND
    Push $0
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    StrCpy $genworkInstallerCacheCopyStartTick $0
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=installer-cache-copy-start attempt_id=$genworkInstallerAttemptId kind=${KIND}$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $0
  !macroend

  !macro customInstallerCacheCopyEnd KIND RESULT
    Push $0
    Push $1
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    IntOp $1 $0 - $genworkInstallerCacheCopyStartTick
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=installer-cache-copy-complete attempt_id=$genworkInstallerAttemptId kind=${KIND} result=${RESULT} elapsed_ms=$1$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  !macroend

  !macro customEstimatedSizeKnown VALUE
    Push $8
    Push $9
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=estimated-size-scan-skipped attempt_id=$genworkInstallerAttemptId source=build-estimate value_kb=${VALUE}$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
  !macroend

  !macro customEstimatedSizeScanStart
    Push $0
    System::Call 'kernel32::GetTickCount()i .r0'
    StrCpy $genworkEstimatedSizeScanStartTick $0
    Pop $0
  !macroend

  !macro customEstimatedSizeScanEnd VALUE
    StrCpy $genworkEstimatedSizeValue ${VALUE}
    Push $0
    Push $1
    Push $8
    Push $9
    System::Call 'kernel32::GetTickCount()i .r0'
    IntOp $1 $0 - $genworkEstimatedSizeScanStartTick
    FileOpen $9 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $9 0 END
    !insertmacro GetTimestamp $8
    FileWrite $9 "$8 phase=estimated-size-scan-complete attempt_id=$genworkInstallerAttemptId value_kb=$genworkEstimatedSizeValue elapsed_ms=$1$\r$\n"
    FileClose $9
    Pop $9
    Pop $8
    Pop $1
    Pop $0
  !macroend
!endif

!macro customBeforeRegistryAddInstallInfo
  ; -- Install Timing Log --
  ; Write timestamps to help diagnose slow installation phases.
  ; Log file: %APPDATA%\GenWork\install-timing.log

  CreateDirectory "$APPDATA\GenWork"
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=app-files-install-complete attempt_id=$genworkInstallerAttemptId$\r$\n"
  FileWrite $2 "$8 phase=nsis-extract-complete attempt_id=$genworkInstallerAttemptId$\r$\n"
  FileClose $2
  DetailPrint "[Installer] Preparing installation steps"

  ; -- Extract combined resource archive (win-resources.tar) --
  ; All large resource directories (openclaw-runtime/, SKILLs/, python-win/) are packed
  ; into a single tar file. NSIS 7z extracts one large file almost instantly;
  ; we then unpack the tar here using Electron's Node runtime.
  ;
  ; The install-scope Defender exclusion was added after every legacy
  ; uninstaller returned and immediately before the NSIS payload extraction;
  ; temporary/legacy entries are trimmed at the end of this macro.

  System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "1")i'

  DetailPrint "[Installer] Extracting bundled resources"
  ; $R2 = current extractor exit code, $R3 = extractor id for logs.
  ; ($R2 survives GetTimestamp, which clobbers $0 -- see the macro note.)
  StrCpy $R2 ""
  StrCpy $R3 "none"
  StrCpy $R4 "none"
  !insertmacro ResolveTrustedTar
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=system-tool-resolved attempt_id=$genworkInstallerAttemptId tool=tar status=$genworkTrustedTarStatus source=$genworkTrustedTarSource path=$genworkTrustedTarPath$\r$\n"
  FileClose $2

  ; -- Attempt 1: Windows built-in bsdtar (Win10 1803+) --
  ; Runs a trusted system binary instead of the freshly written app exe,
  ; which security software tends to freeze for cloud analysis on its first
  ; execution (the root cause of installers hanging at this phase).
  StrCmp $genworkTrustedTarPath "" TarExtractElectron
  StrCpy $R3 "system-tar"
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-start attempt_id=$genworkInstallerAttemptId extractor=system-tar helper=$genworkTrustedTarPath tar=$INSTDIR\resources\win-resources.tar dest=$INSTDIR\resources$\r$\n"
  FileClose $2
  System::Call 'kernel32::GetTickCount()i .r7'
  nsExec::ExecToLog '"$genworkTrustedTarPath" -xf "$INSTDIR\resources\win-resources.tar" -C "$INSTDIR\resources"'
  Pop $0
  StrCpy $R2 $0
  System::Call 'kernel32::GetTickCount()i .r6'
  IntOp $5 $6 - $7
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-exit attempt_id=$genworkInstallerAttemptId extractor=system-tar raw_kind=numeric-or-adapter-exit exit=$R2 elapsed_ms=$5$\r$\n"
  FileClose $2
  StrCmp $R2 "error" TarExtractElectron
  IntCmp $R2 0 TarExtractVerify TarExtractElectron TarExtractElectron

  TarExtractElectron:
  ; -- Attempt 2: bundled Electron Node runtime --
  ; Wrapped in a 10-minute watchdog: if security software freezes the child
  ; before it can run, the installer must fail visibly instead of hanging
  ; forever (a killed installer leaves a half-installed app behind).
  ;
  ; Some security tooling permanently breaks the .NET exit-code query inside
  ; PowerShell ($p.ExitCode stays $null after a successful wait) while the
  ; child itself completes fine. The child therefore publishes a post-verify
  ; sentinel file (.unpack-runtime-ok); a null exit code with the sentinel
  ; present is treated as success, still gated by TarExtractVerify.
  StrCpy $R3 "electron"
  DetailPrint "[Installer] Launching bundled extractor"
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-start attempt_id=$genworkInstallerAttemptId extractor=electron tar=$INSTDIR\resources\win-resources.tar dest=$INSTDIR\resources$\r$\n"
  FileClose $2
  System::Call 'kernel32::GetTickCount()i .r7'

  !insertmacro ResolveTrustedPowerShell
  StrCmp $genworkTrustedPowerShellPath "" TarExtractHelperNotFound
  Delete "$PLUGINSDIR\genwork-watchdog-$genworkInstallerAttemptId.marker"
  ; A stale sentinel from an earlier run must never vouch for this attempt.
  Delete "$INSTDIR\resources\.unpack-runtime-ok"
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_WATCHDOG_MARKER_PATH", t "$PLUGINSDIR\genwork-watchdog-$genworkInstallerAttemptId.marker")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_EXE", t "$INSTDIR\${APP_EXECUTABLE_FILENAME}")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_SCRIPT", t "$INSTDIR\resources\unpack-runtime.cjs")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_ARCHIVE", t "$INSTDIR\resources\win-resources.tar")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_DESTINATION", t "$INSTDIR\resources")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_LOG", t "$APPDATA\GenWork\install-timing.log")i'
  nsExec::ExecToLog '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
    $$ErrorActionPreference = \"Stop\";\
    $$marker = $$env:GENWORK_WATCHDOG_MARKER_PATH;\
    function Write-GenworkWatchdogMarker {\
      param([string] $$value);\
      try {\
        Set-Content -LiteralPath $$marker -Value $$value -NoNewline -ErrorAction Stop\
      } catch {\
        Write-Output (\"GENWORK_WATCHDOG_MARKER_WRITE_FAILED:\" + $$value)\
      }\
    };\
    try {\
      $$extractorArgs = \"`\"\" + $$env:GENWORK_EXTRACTOR_SCRIPT + \"`\" `\"\" + $$env:GENWORK_EXTRACTOR_ARCHIVE + \"`\" `\"\" + $$env:GENWORK_EXTRACTOR_DESTINATION + \"`\" `\"\" + $$env:GENWORK_EXTRACTOR_LOG + \"`\"\";\
      $$p = Start-Process -FilePath $$env:GENWORK_EXTRACTOR_EXE -ArgumentList $$extractorArgs -NoNewWindow -PassThru\
    } catch {\
      Write-GenworkWatchdogMarker \"process-start-blocked\";\
      Write-Output \"GENWORK_WATCHDOG_START_BLOCKED\";\
      exit 125\
    };\
    if ($$p.WaitForExit(600000)) {\
      $$p.WaitForExit();\
      if ($$p.ExitCode -eq $$null) {\
        $$sentinelOk = $$false;\
        try {\
          $$sentinel = Join-Path $$env:GENWORK_EXTRACTOR_DESTINATION \".unpack-runtime-ok\";\
          $$sentinelOk = Test-Path -LiteralPath $$sentinel\
        } catch { $$sentinelOk = $$false };\
        if ($$sentinelOk) {\
          Write-GenworkWatchdogMarker \"exit-code-null-sentinel-ok\";\
          exit 0\
        };\
        Write-GenworkWatchdogMarker \"output-validation-failed\";\
        exit 127\
      };\
      exit $$p.ExitCode\
    };\
    try {\
      Stop-Process -Id $$p.Id -Force -ErrorAction Stop;\
      if (-not $$p.WaitForExit(30000)) {\
        Write-GenworkWatchdogMarker \"process-termination-failed\";\
        Write-Output \"GENWORK_WATCHDOG_TERMINATION_FAILED\";\
        exit 126\
      }\
    } catch {\
      Write-GenworkWatchdogMarker \"process-termination-failed\";\
      Write-Output \"GENWORK_WATCHDOG_TERMINATION_FAILED\";\
      exit 126\
    };\
    Write-GenworkWatchdogMarker \"process-timeout\";\
    Write-Output \"GENWORK_WATCHDOG_TIMEOUT\";\
    exit 124"'
  Pop $0
  StrCpy $R2 $0
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_WATCHDOG_MARKER_PATH", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_EXE", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_SCRIPT", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_ARCHIVE", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_DESTINATION", t "")i'
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_EXTRACTOR_LOG", t "")i'
  StrCpy $R4 "none"
  ClearErrors
  FileOpen $3 "$PLUGINSDIR\genwork-watchdog-$genworkInstallerAttemptId.marker" r
  IfErrors TarExtractMarkerReadDone
    FileRead $3 $R4
    FileClose $3
  TarExtractMarkerReadDone:
  Delete "$PLUGINSDIR\genwork-watchdog-$genworkInstallerAttemptId.marker"
  Goto TarExtractWatchdogReturned

  TarExtractHelperNotFound:
  StrCpy $R2 "helper-not-found"
  StrCpy $R4 "helper-not-found"

  TarExtractWatchdogReturned:
  System::Call 'kernel32::GetTickCount()i .r6'
  IntOp $5 $6 - $7
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-exit attempt_id=$genworkInstallerAttemptId extractor=electron raw_marker=$R4 exit=$R2 elapsed_ms=$5$\r$\n"
  FileClose $2

  ; "error" = nsExec couldn't start PowerShell (check before IntCmp, which
  ; converts non-numeric strings to 0 and would misidentify "error" as success)
  StrCmp $R2 "error" TarExtractProcessFailed
  StrCmp $R2 "helper-not-found" TarExtractProcessFailed
  ; Marker persistence is diagnostic only. A frozen child can also block or
  ; deny writes to $PLUGINSDIR, so the dedicated wrapper exit must independently
  ; select the no-concurrent-rollback path.
  StrCmp $R2 "126" TarExtractTerminationFailed
  StrCmp $R4 "process-start-blocked" TarExtractProcessFailed
  StrCmp $R4 "process-termination-failed" TarExtractTerminationFailed
  StrCmp $R4 "output-validation-failed" TarExtractOutputValidationFailed
  StrCmp $R4 "process-timeout" 0 TarExtractNumericResult
  StrCmp $R2 "124" TarExtractTimeout TarExtractOutputValidationFailed
  TarExtractNumericResult:
  ; IntCmp tolerates trailing whitespace/CR that StrCmp would reject
  IntCmp $R2 0 TarExtractVerify TarExtractNonZero TarExtractNonZero

  TarExtractVerify:
  ; Success requires every large bundled resource to be usable -- an exit code
  ; alone must never trigger deletion of the only recovery source.
  IfFileExists "$INSTDIR\resources\openclaw-runtime\gateway-bundle.mjs" TarExtractVerifySkills
  IfFileExists "$INSTDIR\resources\openclaw-runtime\openclaw.mjs" TarExtractVerifySkills
  StrCpy $R5 "runtime-entry-missing"
  Goto TarExtractRequiredResourceMissing

  TarExtractVerifySkills:
  IfFileExists "$INSTDIR\resources\SKILLs\*.*" TarExtractVerifyPython
  StrCpy $R5 "skills-content-missing"
  Goto TarExtractRequiredResourceMissing

  TarExtractVerifyPython:
  IfFileExists "$INSTDIR\resources\python-win\python.exe" TarExtractSucceeded
  IfFileExists "$INSTDIR\resources\python-win\python3.exe" TarExtractSucceeded
  StrCpy $R5 "python-entry-missing"

  TarExtractRequiredResourceMissing:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 reason=$R5-after-extract$\r$\n"
  FileClose $2
  ; A bogus system-tar success still gets a shot at the bundled extractor.
  ;
  ; /SD IDOK on this and the failure boxes below: NSIS shows MessageBox even
  ; in /S installs unless a silent default is declared, and the in-app update
  ; must never block on an orphan dialog.
  StrCmp $R3 "system-tar" TarExtractElectron
  MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because resource extraction completed without all required runtime resources ($R5). The installer will not commit a partial application. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
  Goto TarExtractFailed

  TarExtractProcessFailed:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 reason=process-start-failed$\r$\n"
    FileClose $2
    MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because the resource extractor could not be started (exit=$R2). The installer will not commit a partial application. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    Goto TarExtractFailed

  TarExtractTimeout:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 reason=timeout$\r$\n"
    FileClose $2
    MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because resource extraction timed out after 10 minutes. The blocked extractor was terminated and the installer will not commit a partial application. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    Goto TarExtractFailed

  TarExtractTerminationFailed:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 reason=process-termination-failed action=preserve-all-no-concurrent-rollback$\r$\n"
    FileClose $2
    System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "")i'
    ${If} ${Silent}
      Banner::destroy
    ${EndIf}
    MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because the extractor process could not be confirmed terminated. No automatic rollback or cleanup was attempted while that process may still be writing files. Restart Windows before retrying. Recovery files (if any): $genworkOldInstallBackupPath. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    SetErrorLevel 3
    Quit

  TarExtractOutputValidationFailed:
    ; The watchdog waited out the child but could not read its exit code. On
    ; machines where security tooling permanently breaks that query the child
    ; may still have succeeded, so consult its post-verify sentinel before
    ; declaring failure; TarExtractVerify still makes the final on-disk call.
    ; (Dual of the TarExtractVerify principle: just as an exit code alone must
    ; never trigger deletion, an unreadable exit code alone must never abort
    ; an installation whose payload verifiably exists.)
    IfFileExists "$INSTDIR\resources\.unpack-runtime-ok" 0 TarExtractOutputValidationFatal
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-sentinel-rescue attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 sentinel=present$\r$\n"
    FileClose $2
    Goto TarExtractVerify

  TarExtractOutputValidationFatal:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 reason=watchdog-output-validation-failed$\r$\n"
    FileClose $2
    MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because the resource extractor watchdog returned an invalid result. The installer will not commit a partial application. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    Goto TarExtractFailed

  TarExtractNonZero:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=tar-extract-error attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 elapsed_ms=$5 reason=numeric-child-exit$\r$\n"
    FileClose $2
    MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because resource extraction failed (child exit code $R2). The installer will not commit a partial application. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    Goto TarExtractFailed

  TarExtractSucceeded:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-complete attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2$\r$\n"
  FileClose $2
  ; Completion marker, read by the app for install-integrity diagnostics.
  FileOpen $2 "$INSTDIR\resources\.win-resources-extracted" w
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 source=installer extractor=$R3$\r$\n"
  FileClose $2
  DetailPrint "[Installer] Bundled resources extraction complete"
  ; Only a verified success may delete these: the preserved archive is what
  ; lets the app finish an interrupted extraction at first launch. The
  ; sentinel has served its purpose once the install commits.
  Delete "$INSTDIR\resources\win-resources.tar"
  Delete "$INSTDIR\resources\unpack-runtime.cjs"
  Delete "$INSTDIR\resources\.unpack-runtime-ok"
  Goto TarExtractDone

  TarExtractFailed:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=tar-extract-failed-archive-preserved attempt_id=$genworkInstallerAttemptId extractor=$R3 exit=$R2 raw_marker=$R4 action=abort-install$\r$\n"
  FileClose $2
  System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "")i'
  !insertmacro customRollbackOldInstall "resource-extraction-failed"
  StrCmp $genworkOldInstallRollbackStatus "failed" 0 TarExtractAbort
    MessageBox MB_OK|MB_ICONEXCLAMATION "The installation failed and automatic rollback did not complete. No recovery copy was deleted. Previous files: $genworkOldInstallBackupPath. Partial update: $genworkOldInstallFailedPath. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
  TarExtractAbort:
  ${If} ${Silent}
    Banner::destroy
  ${EndIf}
  SetErrorLevel 3
  Quit
  TarExtractDone:

  ; -- Restore user-created skills from AppData backup --
  ; The backup was created in customCheckAppRunning before extraction began.
  ; Restore any skills not already present in the new install, then clean up
  ; only this attempt's backup. A later attempt never consumes a historical
  ; fixed skills-backup directory.
  StrCmp $genworkLegacySkillsStatus "legacy-backup-succeeded" 0 SkipSkillRestore
  System::Call 'kernel32::GetTickCount()i .r7'
  IfFileExists "$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId\backup-manifest.json" SkillRestoreAttemptBackupReady
    StrCpy $R2 "backup-missing"
    StrCpy $1 "current-attempt-backup-manifest-missing"
    StrCpy $genworkLegacySkillsRestoreStatus "legacy-restore-backup-missing"
    Goto SkillRestoreCommandDone

  SkillRestoreAttemptBackupReady:
    DetailPrint "[Installer] Restoring user-created skills"
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=skill-restore-start attempt_id=$genworkInstallerAttemptId backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
    FileClose $2

    StrCmp $genworkTrustedPowerShellPath "" SkillRestoreHelperMissing
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_SOURCE", t "$genworkOldInstallOriginalPath\resources\SKILLs")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_BACKUP_ROOT", t "$APPDATA\GenWork\skills-backup")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_DESTINATION", t "$INSTDIR\resources\SKILLs")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ATTEMPT_ID", t "$genworkInstallerAttemptId")i'
    nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "\
      $$ErrorActionPreference = \"Stop\";\
      $$attempt   = $$env:GENWORK_INSTALL_ATTEMPT_ID;\
      $$root      = $$env:GENWORK_SKILL_BACKUP_ROOT;\
      $$source    = $$env:GENWORK_SKILL_SOURCE;\
      $$backup    = Join-Path $$root $$attempt;\
      $$newSkills = $$env:GENWORK_SKILL_DESTINATION;\
      try {\
        if ([string]::IsNullOrWhiteSpace($$attempt)) { throw \"attempt id missing\" };\
        $$manifestPath = Join-Path $$backup \"backup-manifest.json\";\
        $$manifest = Get-Content -LiteralPath $$manifestPath -Raw -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop;\
        if ($$manifest.schemaVersion -ne 1) { throw \"manifest schema mismatch\" };\
        if ($$manifest.attemptId -ne $$attempt) { throw \"manifest attempt mismatch\" };\
        if ($$manifest.source -ne $$source) { throw \"manifest source mismatch\" };\
        if ($$manifest.validation.status -ne \"verified\") { throw \"manifest not verified\" };\
        if ((Get-Content -LiteralPath (Join-Path $$backup \".attempt-id\") -Raw -ErrorAction Stop) -ne $$attempt) { throw \"attempt marker mismatch\" };\
        $$skills = @($$manifest.skills);\
        if ($$skills.Count -ne [int]$$manifest.statistics.skillCount) { throw \"manifest skill count mismatch\" };\
        if (@($$manifest.files).Count -ne [int]$$manifest.statistics.fileCount) { throw \"manifest file count mismatch\" };\
        if (@($$manifest.directories).Count -ne [int]$$manifest.statistics.directoryCount) { throw \"manifest directory count mismatch\" };\
        $$backupPrefix = [IO.Path]::GetFullPath($$backup).TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar;\
        foreach ($$skill in $$skills) {\
          if ([string]::IsNullOrWhiteSpace($$skill) -or ([IO.Path]::GetFileName($$skill) -ne $$skill) -or ($$skill -eq \".\") -or ($$skill -eq \"..\")) { throw \"unsafe manifest skill name\" };\
          if (-not (Test-Path -LiteralPath (Join-Path $$backup $$skill) -PathType Container)) { throw \"manifest skill missing\" }\
        };\
        foreach ($$file in @($$manifest.files)) {\
          if ([IO.Path]::IsPathRooted($$file.path)) { throw \"rooted manifest path\" };\
          $$relative = $$file.path.Replace([char]47, [IO.Path]::DirectorySeparatorChar);\
          $$candidate = [IO.Path]::GetFullPath((Join-Path $$backup $$relative));\
          if (-not $$candidate.StartsWith($$backupPrefix, [StringComparison]::OrdinalIgnoreCase)) { throw \"manifest path escaped backup\" };\
          $$top = @($$file.path.Split([char]47))[0];\
          if (($$file.path -ne \".attempt-id\") -and ($$skills -notcontains $$top)) { throw \"manifest file outside skill\" };\
          if (-not (Test-Path -LiteralPath $$candidate -PathType Leaf)) { throw \"manifest file missing\" };\
          if ((Get-FileHash -LiteralPath $$candidate -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant() -ne $$file.sha256) { throw \"manifest hash mismatch\" }\
        };\
        New-Item -ItemType Directory -Path $$newSkills -Force -ErrorAction Stop | Out-Null;\
        $$conflicts = @($$skills | Where-Object { Test-Path -LiteralPath (Join-Path $$newSkills $$_) });\
        if ($$conflicts.Count -gt 0) {\
          Write-Output (\"name-conflict:\" + (($$conflicts | Sort-Object) -join \",\"));\
          exit 20\
        };\
        $$restored = 0;\
        $$restoredNames = @();\
        foreach ($$skill in $$skills) {\
          $$target = Join-Path $$newSkills $$skill;\
          if (-not (Test-Path -LiteralPath $$target)) {\
            Copy-Item -LiteralPath (Join-Path $$backup $$skill) -Destination $$target -Recurse -Force -ErrorAction Stop;\
            $$restoredNames += $$skill;\
            $$restored++\
          }\
        };\
        foreach ($$file in @($$manifest.files)) {\
          $$top = @($$file.path.Split([char]47))[0];\
          if ($$restoredNames -contains $$top) {\
            $$destinationFile = Join-Path $$newSkills ($$file.path.Replace([char]47, [IO.Path]::DirectorySeparatorChar));\
            if ((Get-FileHash -LiteralPath $$destinationFile -Algorithm SHA256 -ErrorAction Stop).Hash.ToLowerInvariant() -ne $$file.sha256) { throw \"restored hash mismatch\" }\
          }\
        };\
        Remove-Item -LiteralPath $$backup -Recurse -Force -ErrorAction Stop;\
        Write-Output (\"restored:\" + $$restored + \" manifest-files:\" + $$manifest.statistics.fileCount);\
        exit 0\
      } catch {\
        exit 1\
      }"'
    Pop $0
    Pop $1
    StrCpy $R2 $0
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_SOURCE", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_BACKUP_ROOT", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_SKILL_DESTINATION", t "")i'
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ATTEMPT_ID", t "")i'
    Goto SkillRestoreCommandDone

    SkillRestoreHelperMissing:
    StrCpy $R2 "helper-not-found"
    StrCpy $1 "trusted-powershell-unavailable"
    StrCpy $genworkLegacySkillsRestoreStatus "legacy-restore-helper-launch-failed"

    SkillRestoreCommandDone:
    StrCmp $R2 "0" 0 +2
      StrCpy $genworkLegacySkillsRestoreStatus "legacy-restore-succeeded"
    StrCmp $R2 "20" 0 +2
      StrCpy $genworkLegacySkillsRestoreStatus "legacy-restore-name-conflict"
    StrCmp $genworkLegacySkillsRestoreStatus "not-required" 0 +2
      StrCpy $genworkLegacySkillsRestoreStatus "legacy-restore-failed"
    System::Call 'kernel32::GetTickCount()i .r6'
    IntOp $5 $6 - $7
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=skill-restore-complete attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsRestoreStatus exit=$R2 elapsed_ms=$5 backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
    FileWrite $2 "$8 phase=skill-restore-output attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsRestoreStatus text=$1$\r$\n"
    FileClose $2

    StrCmp $R2 "0" SkillRestoreValidated
    StrCmp $R2 "20" SkillRestoreConflictPreserved
      FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $2 0 END
      !insertmacro GetTimestamp $8
      FileWrite $2 "$8 phase=skill-restore-failed attempt_id=$genworkInstallerAttemptId status=legacy-restore-failed action=attempt-backup-preserved rename_status=$genworkOldInstallRenameStatus$\r$\n"
      FileClose $2

      ; On the directory-swap path, restoring the previous application also
      ; restores its original in-place skills. The AppData copy remains as an
      ; additional recovery source because the PowerShell transaction deletes
      ; it only after every skill copy succeeds.
      StrCmp $genworkOldInstallRenameStatus "success" 0 SkillRestoreFailurePreserved
      System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "")i'
      !insertmacro customRollbackOldInstall "skill-restore-failed"
      StrCmp $genworkOldInstallRollbackStatus "success" SkillRestoreRollbackSucceeded
        MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update could not restore user skills, and automatic rollback did not complete. No recovery copy was deleted. Previous files: $genworkOldInstallBackupPath. Partial update: $genworkOldInstallFailedPath. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
        Goto SkillRestoreAbort
      SkillRestoreRollbackSucceeded:
        MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update could not restore user skills, so the previous version was restored. Please retry the update. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      SkillRestoreAbort:
      ${If} ${Silent}
        Banner::destroy
      ${EndIf}
      SetErrorLevel 2
      Quit

    SkillRestoreFailurePreserved:
      ; The stock-uninstaller fallback has no intact directory to roll back.
      ; Preserve P0 compatibility: keep the usable new payload and continue to
      ; registration, but record an explicit degraded state for retry/manual
      ; recovery. The dialog must state exactly what survives: when no backup
      ; exists for this attempt, do not claim one was preserved.
      StrCmp $genworkLegacySkillsRestoreStatus "legacy-restore-backup-missing" SkillRestoreDegradedBackupMissing
      FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $2 0 END
      !insertmacro GetTimestamp $8
      FileWrite $2 "$8 phase=skill-restore-degraded attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsRestoreStatus action=continue-with-attempt-backup-preserved backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
      FileClose $2
      MessageBox MB_OK|MB_ICONEXCLAMATION "GenWork will finish installing, but legacy user skills could not be restored automatically ($genworkLegacySkillsRestoreStatus). The recovery backup was preserved at $APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      Goto SkillRestoreValidated

    SkillRestoreDegradedBackupMissing:
      ; No backup exists for this attempt, so nothing could be restored and
      ; there is no preserved copy to point the user at.
      FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $2 0 END
      !insertmacro GetTimestamp $8
      FileWrite $2 "$8 phase=skill-restore-degraded attempt_id=$genworkInstallerAttemptId status=$genworkLegacySkillsRestoreStatus action=continue-no-backup-found backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
      FileClose $2
      MessageBox MB_OK|MB_ICONEXCLAMATION "GenWork will finish installing, but the recovery backup for legacy user skills was not found, so no skills were restored ($genworkLegacySkillsRestoreStatus). Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      Goto SkillRestoreValidated

    SkillRestoreConflictPreserved:
      ; A same-name entry in the new tree must never cause the user's only
      ; copy to be overwritten or deleted. Finish installing the verified new
      ; app, retain the entire attempt backup, and expose a typed state for
      ; user-context import/manual recovery.
      FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
      FileSeek $2 0 END
      !insertmacro GetTimestamp $8
      FileWrite $2 "$8 phase=skill-restore-conflict-preserved attempt_id=$genworkInstallerAttemptId status=name-conflict action=attempt-backup-preserved backup=$APPDATA\GenWork\skills-backup\$genworkInstallerAttemptId$\r$\n"
      FileClose $2
    SkillRestoreValidated:
  SkipSkillRestore:

  System::Call 'Kernel32::SetEnvironmentVariable(t "ELECTRON_RUN_AS_NODE", t "")i'

  ; The unpack script is deleted in TarExtractSucceeded above; after a failed
  ; extraction it is intentionally kept alongside win-resources.tar.

  ; -- Rebalance Defender exclusions now that extraction is done --
  ; Unconditionally remove the install-scope whole-directory entry (also the
  ; leftover of an interrupted install -- the entry path is always $INSTDIR,
  ; so this step self-heals it) and the SKILLs entry older installers added.
  !insertmacro ResolveTrustedPowerShell
  StrCmp $genworkTrustedPowerShellPath "" DefenderTrimHelperMissing
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "$INSTDIR")i'
  nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "try { $$root = $$env:GENWORK_INSTALL_ROOT; $$targets = @($$root, (Join-Path $$root \"resources\SKILLs\")); Remove-MpPreference -ExclusionPath $$targets -ErrorAction SilentlyContinue; Write-Output \"removed\" } catch { Write-Output (\"failed: \" + $$_.Exception.Message) }"'
  Pop $0
  Pop $1
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "")i'
  Goto DefenderTrimLog
  DefenderTrimHelperMissing:
  StrCpy $0 "helper-not-found"
  StrCpy $1 "skipped:trusted-powershell-unavailable"
  DefenderTrimLog:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=defender-exclusion-trim-complete attempt_id=$genworkInstallerAttemptId exit=$0 output=$1$\r$\n"
  FileClose $2

  ; Re-add the permanent entries; skipped entirely when the
  ; /NoDefenderExclusion opt-out is present -- the removals above are not.
  ;
  ; Besides the three runtime trees, this PRE-PROVISIONS the two biggest
  ; single files of the NEXT upgrade: win-resources.tar and app.asar. Field
  ; finding (EICAR-verified on a machine where install-time exclusions never
  ; worked): Defender applies newly added exclusions asynchronously, minutes
  ; later -- entries added mid-install protect nothing, while entries that
  ; have been sitting since the previous install are fully honored. Risk:
  ; the tar path points at a file that only exists during an install, and
  ; app.asar is the same trust class as the already-excluded
  ; app.asar.unpacked. SKILLs stays scannable (user-writable,
  ; agent-executed).
  ${GetParameters} $R9
  ClearErrors
  ${GetOptions} $R9 "/NoDefenderExclusion" $R8
  IfErrors 0 DefenderPermanentAddSkipped
  StrCmp $genworkTrustedPowerShellPath "" DefenderPermanentAddHelperMissing
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "$INSTDIR")i'
  nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "try { $$root = $$env:GENWORK_INSTALL_ROOT; $$targets = @((Join-Path $$root \"resources\openclaw-runtime\"), (Join-Path $$root \"resources\python-win\"), (Join-Path $$root \"resources\app.asar.unpacked\"), (Join-Path $$root \"resources\app.asar\"), (Join-Path $$root \"resources\win-resources.tar\")); Add-MpPreference -ExclusionPath $$targets -ErrorAction Stop; Write-Output \"added\" } catch { Write-Output (\"skipped: \" + $$_.Exception.Message) }"'
  Pop $0
  Pop $1
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "")i'
  Goto DefenderPermanentAddLog
  DefenderPermanentAddHelperMissing:
  StrCpy $0 "helper-not-found"
  StrCpy $1 "skipped:trusted-powershell-unavailable"
  DefenderPermanentAddLog:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=defender-exclusion-permanent-complete attempt_id=$genworkInstallerAttemptId exit=$0 output=$1$\r$\n"
  FileClose $2
  DefenderPermanentAddSkipped:

  ; Validate every scenario before electron-builder writes new registration
  ; or shortcuts. The archive and unpack script are diagnostic recovery
  ; material, never a successful validation condition.
  StrCpy $genworkNewInstallValidationStatus "failed"
  StrCpy $genworkNewInstallValidationReason "app-executable-missing"
  IfFileExists "$INSTDIR\${APP_EXECUTABLE_FILENAME}" 0 NewInstallPrevalidateFailed
  StrCpy $genworkNewInstallValidationReason "uninstaller-missing"
  IfFileExists "$INSTDIR\${UNINSTALL_FILENAME}" 0 NewInstallPrevalidateFailed
  StrCpy $genworkNewInstallValidationReason "app-asar-missing"
  IfFileExists "$INSTDIR\resources\app.asar" 0 NewInstallPrevalidateFailed

  IfFileExists "$INSTDIR\resources\openclaw-runtime\gateway-bundle.mjs" NewInstallPrevalidateSkills
  IfFileExists "$INSTDIR\resources\openclaw-runtime\openclaw.mjs" NewInstallPrevalidateSkills
  StrCpy $genworkNewInstallValidationReason "runtime-entry-missing"
  Goto NewInstallPrevalidateFailed

  NewInstallPrevalidateSkills:
    StrCpy $genworkNewInstallValidationReason "skills-content-missing"
    IfFileExists "$INSTDIR\resources\SKILLs\*.*" 0 NewInstallPrevalidateFailed
    StrCpy $genworkNewInstallValidationReason "python-entry-missing"
    IfFileExists "$INSTDIR\resources\python-win\python.exe" NewInstallPrevalidateSucceeded
    IfFileExists "$INSTDIR\resources\python-win\python3.exe" NewInstallPrevalidateSucceeded
    Goto NewInstallPrevalidateFailed

  NewInstallPrevalidateSucceeded:
    StrCpy $genworkNewInstallValidationStatus "success"
    StrCpy $genworkNewInstallValidationReason "new-install-runtime-ready"
    StrCmp $genworkOldInstallRenameStatus "success" 0 NewInstallPrevalidateLog
      StrCpy $genworkOldInstallRenameStatus "prevalidated"
    NewInstallPrevalidateLog:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=new-install-prevalidated attempt_id=$genworkInstallerAttemptId status=$genworkNewInstallValidationStatus reason=$genworkNewInstallValidationReason rename_status=$genworkOldInstallRenameStatus registration=pending backup_path=$genworkOldInstallBackupPath$\r$\n"
    FileClose $2
    Goto NewInstallPrevalidateDone

  NewInstallPrevalidateFailed:
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=new-install-prevalidation-failed attempt_id=$genworkInstallerAttemptId status=$genworkNewInstallValidationStatus reason=$genworkNewInstallValidationReason rename_status=$genworkOldInstallRenameStatus registration=not-written backup_path=$genworkOldInstallBackupPath$\r$\n"
    FileClose $2
    StrCmp $genworkOldInstallRenameStatus "success" 0 NewInstallPrevalidateAbort
    !insertmacro customRollbackOldInstall "new-install-validation-failed"
    StrCmp $genworkOldInstallRollbackStatus "success" NewInstallPrevalidateRollbackSucceeded
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update could not be validated, and automatic rollback did not complete. No recovery copy was deleted. Previous files: $genworkOldInstallBackupPath. Partial update: $genworkOldInstallFailedPath. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      Goto NewInstallPrevalidateAbortAfterMessage
    NewInstallPrevalidateRollbackSucceeded:
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork update could not be validated, so the previous version was restored. Please retry the update. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
      Goto NewInstallPrevalidateAbortAfterMessage
    NewInstallPrevalidateAbort:
      MessageBox MB_OK|MB_ICONEXCLAMATION "The GenWork installation stopped because the new application could not be validated ($genworkNewInstallValidationReason). New registration and shortcuts were not written. Details: $APPDATA\GenWork\install-timing.log" /SD IDOK
    NewInstallPrevalidateAbortAfterMessage:
    ${If} ${Silent}
      Banner::destroy
    ${EndIf}
    SetErrorLevel 2
    Quit

  NewInstallPrevalidateDone:
!macroend

; Standard post-registry electron-builder hook. All fallible extraction,
; restoration, Defender rebalancing and validation completed in
; customBeforeRegistryAddInstallInfo. This hook only commits the already
; prevalidated directory swap and schedules exact-current-backup cleanup.
!macro customInstall
  StrCmp $genworkNewInstallValidationStatus "success" 0 InstallFinalizeInvariantFailed
  StrCmp $genworkOldInstallRenameStatus "prevalidated" 0 InstallFinalizeNoRename
    StrCpy $genworkOldInstallRenameStatus "committed"
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=old-install-commit-complete attempt_id=$genworkInstallerAttemptId status=$genworkNewInstallValidationStatus reason=$genworkNewInstallValidationReason registration=written backup_path=$genworkOldInstallBackupPath$\r$\n"
    FileClose $2
  InstallFinalizeNoRename:

  ; A successful rename keeps the old tree intact during extraction. Only a
  ; validated commit may schedule deletion, and only for this run's exact
  ; backup path. Older interrupted backups remain untouched for recovery.
  ; Pass the path through the environment to avoid shell interpretation of a
  ; user-selected install directory. Exec is asynchronous, so this phase is
  ; "scheduled", not complete.
  ${If} $genworkOldInstallRenameStatus == "committed"
    StrCpy $0 "success"
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_OLD_CLEANUP_PATH", t "$genworkOldInstallBackupPath")i'
    ClearErrors
    StrCmp $genworkTrustedPowerShellPath "" OldInstallCleanupHelperMissing
    Exec '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -WindowStyle Hidden -Command "Remove-Item -LiteralPath $$env:GENWORK_OLD_CLEANUP_PATH -Recurse -Force -ErrorAction SilentlyContinue"'
    IfErrors 0 +2
      StrCpy $0 "launch-failed"
    Goto OldInstallCleanupDispatchDone
    OldInstallCleanupHelperMissing:
      StrCpy $0 "helper-not-found"
    OldInstallCleanupDispatchDone:
    System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_OLD_CLEANUP_PATH", t "")i'
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=old-install-cleanup-scheduled attempt_id=$genworkInstallerAttemptId dispatch=$0 backup_path=$genworkOldInstallBackupPath target=exact-current-backup cleanup_mode=async-exec-after-commit$\r$\n"
    FileClose $2
  ${EndIf}
  Goto InstallFinalizeComplete

  InstallFinalizeInvariantFailed:
    ; The version-pinned template contract guarantees the pre-registry hook.
    ; Fail visibly if that contract is ever broken instead of silently
    ; finalizing an unvalidated tree.
    FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
    FileSeek $2 0 END
    !insertmacro GetTimestamp $8
    FileWrite $2 "$8 phase=install-finalize-invariant-failed attempt_id=$genworkInstallerAttemptId validation_status=$genworkNewInstallValidationStatus rename_status=$genworkOldInstallRenameStatus$\r$\n"
    FileClose $2
    SetErrorLevel 2
    Quit

  InstallFinalizeComplete:
  FileOpen $2 "$APPDATA\GenWork\install-timing.log" a
  FileSeek $2 0 END
  !insertmacro GetTimestamp $8
  FileWrite $2 "$8 phase=install-complete attempt_id=$genworkInstallerAttemptId scenario=$genworkInstallScenario$\r$\n"
  FileClose $2
  DetailPrint "[Installer] Installation complete"

  ${If} ${Silent}
    Banner::destroy
  ${EndIf}
!macroend

; customUnInit intentionally not defined: the uninstaller stops app processes
; through customCheckAppRunning above, which the template invokes after the
; user confirms the uninstall (assisted mode) or immediately for silent /S
; uninstalls. Merely opening the uninstaller no longer kills the running app.

!macro customUnInstall
  ; -- Remove Windows Defender Exclusion on uninstall --
  ; Clean up every exclusion any installer version may have added: the
  ; current permanent set, the SKILLs entry from older versions, the
  ; single-file entries from the path-list era, and the install-scope
  ; whole-directory entry in case an install was interrupted before its
  ; rebalance step ran.
  !insertmacro ResolveTrustedPowerShell
  StrCmp $genworkTrustedPowerShellPath "" DefenderUninstallCleanupDone
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "$INSTDIR")i'
  nsExec::ExecToStack '"$genworkTrustedPowerShellPath" -NoProfile -NonInteractive -Command "try { $$root = $$env:GENWORK_INSTALL_ROOT; $$targets = @($$root, (Join-Path $$root \"resources\openclaw-runtime\"), (Join-Path $$root \"resources\python-win\"), (Join-Path $$root \"resources\SKILLs\"), (Join-Path $$root \"resources\app.asar.unpacked\"), (Join-Path $$root \"resources\win-resources.tar\"), (Join-Path $$root \"resources\app.asar\")); Remove-MpPreference -ExclusionPath $$targets -ErrorAction SilentlyContinue } catch {}"'
  Pop $0
  Pop $1
  System::Call 'Kernel32::SetEnvironmentVariable(t "GENWORK_INSTALL_ROOT", t "")i'
  DefenderUninstallCleanupDone:
!macroend
